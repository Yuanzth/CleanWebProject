@{ Layout = "~/Views/Shared/_Layout.cshtml"; }

@{ ViewData["Title"] = "Dashboard"; }

@section styles {
    <link rel="stylesheet" href="/assets/css/dashboard.css">
    <style>
    .db-anm-menu { position: relative; flex-shrink: 0; }
    .db-anm-actions { display: flex; align-items: center; gap: 6px; flex-shrink: 0; position: relative; }
    .db-anm-actions--has-menu .db-badge { transition: transform 0.16s ease; }
    .db-anm-actions--has-menu .db-anm-menu { width: 0; position: relative; }

    .db-anm-menu__trigger {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 22px;
        height: 22px;
        border: 0;
        border-radius: 999px;
        background: transparent;
        color: #94a3b8;
        font-size: 0.78rem;
        cursor: pointer;
        opacity: 0;
        pointer-events: none !important;
        position: absolute;
        right: 0;
        top: 50%;
        transform: translateY(-50%) scale(0.96);
        transition: opacity 0.16s, background 0.16s, color 0.16s, transform 0.12s;
        z-index: 10;
    }

    .db-anomaly-card:hover .db-anm-menu__trigger,
    .db-anm-menu:focus-within .db-anm-menu__trigger {
        opacity: 1;
        pointer-events: auto !important;
        transform: translateY(-50%) scale(1);
    }

    .db-anomaly-card:hover .db-anm-actions--has-menu .db-badge,
    .db-anm-actions--has-menu:focus-within .db-badge {
        transform: translateX(-18px);
    }

    .db-anm-menu__trigger:hover {
        background: rgba(148, 163, 184, 0.14);
        color: #475569;
        transform: translateY(-50%) scale(1.04);
    }

    .db-anm-menu__trigger:focus-visible {
        opacity: 1;
        outline: 1px solid #cbd5e1;
        outline-offset: 1px;
    }

    .db-anm-menu__dropdown {
        position: absolute;
        top: calc(100% + 6px);
        right: 0;
        min-width: 150px;
        padding: 6px;
        border: 1px solid #e2e8f0;
        border-radius: 8px;
        background: #fff;
        box-shadow: 0 8px 20px rgba(15, 23, 42, 0.12);
        z-index: 30;
        pointer-events: auto;
    }

    .db-anm-menu__dropdown.is-hidden { display: none; }

    .db-ack-action {
        width: 100%;
        border: 0;
        border-radius: 6px;
        background: transparent;
        color: #334155;
        font-size: 0.75rem;
        font-weight: 600;
        text-align: left;
        padding: 7px 8px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        cursor: pointer;
    }

    .db-ack-action:hover:not(:disabled) { background: #f1f5f9; }
    .db-ack-action--done { color: #16a34a; cursor: default; }
    @@keyframes db-ack-spin { to { transform: rotate(360deg); } }
    .db-ack-action--loading i { animation: db-ack-spin 0.7s linear infinite; }
    .db-ack-action--loading { opacity: 0.6; pointer-events: none !important; }
    .db-ack-action--error { color: #ef4444 !important; }
    .db-anomaly-card--acked {
        position: relative;
        overflow: hidden;
    }

    .db-anomaly-card--acked .db-anomaly-card__header,
    .db-anomaly-card--acked .db-anomaly-card__body {
        opacity: 0.56;
        filter: grayscale(0.35);
        transition: opacity 0.4s, filter 0.4s;
        position: relative;
        z-index: 1;
    }

    .db-ack-ribbon {
        position: absolute;
        top: 52%;
        right: -78%;
        width: 260%;
        height: 18px;
        transform: translateY(-50%) rotate(-33deg);
        transform-origin: center;
        pointer-events: none;
        z-index: 140;
        border-radius: 999px;
        border: 1px solid rgba(255, 255, 255, 0.35);
        box-shadow: 0 6px 14px rgba(15, 23, 42, 0.2);
        overflow: hidden;
        background: linear-gradient(90deg, rgba(245, 158, 11, 0.46), rgba(234, 88, 12, 0.46));
    }

    .db-anomaly-card--panel-generator .db-ack-ribbon {
        top: 54%;
        right: -160%;
        width: 430%;
        transform: translateY(-50%) rotate(-45deg);
    }

    .db-ack-ribbon--critical {
        background: linear-gradient(90deg, rgba(239, 68, 68, 0.46), rgba(185, 28, 28, 0.46));
    }

    .db-ack-ribbon__track {
        position: absolute;
        inset: 0;
        display: flex;
        align-items: center;
        white-space: nowrap;
        animation: db-ack-ribbon-scroll 7.2s linear infinite;
        will-change: transform;
        animation-play-state: running;
    }

    .db-ack-ribbon__text {
        color: #ffffff;
        font-size: 0.6rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        opacity: 0.64;
        text-shadow: 0 1px 2px rgba(0, 0, 0, 0.28);
        padding-right: 16px;
        flex-shrink: 0;
    }

    @@keyframes db-ack-ribbon-scroll {
        from { transform: translateX(0); }
        to { transform: translateX(-50%); }
    }

    @@media (hover: none) {
        .db-anm-actions--has-menu { padding-right: 24px; }
        .db-anm-actions--has-menu .db-badge { transform: none !important; }
        .db-anm-menu__trigger {
            opacity: 0.85;
            pointer-events: auto !important;
            top: 50%;
            transform: translateY(-50%) scale(1);
        }

        .db-ack-ribbon {
            top: 52%;
            right: -95%;
            width: 300%;
            height: 16px;
        }

        .db-anomaly-card--panel-generator .db-ack-ribbon {
            top: 55%;
            right: -142%;
            width: 470%;
            transform: translateY(-50%) rotate(-39deg);
        }

        .db-ack-ribbon__text {
            font-size: 0.56rem;
            letter-spacing: 0.07em;
        }
    }
    </style>
}


<div class="db-page">

    <div class="db-page-header">
        @await Html.PartialAsync("Components/_SiteFilter")
        <h1>Dashboard</h1>
    </div>

    @* STAT CARDS ROW *@
    @* STAT CARDS ROW *@
    <div class="db-stat-grid">

        @{
            var vdStat1 = new ViewDataDictionary(ViewData);
            vdStat1["label"] = "BTS TOWER UP";
            vdStat1["count"] = ViewBag.stats?.tower_up ?? 0;
            vdStat1["total"] = ViewBag.stats?.tower_total ?? 0;
            vdStat1["id"] = "count-tower-up";
            vdStat1["totalId"] = "count-tower-total";
            vdStat1["iconClass"] = "fa-solid fa-tower-broadcast";
            vdStat1["borderColor"] = "#3b82f6";
            vdStat1["iconBg"] = "rgba(59,130,246,0.12)";
            vdStat1["clickable"] = false;
        }
        @await Html.PartialAsync("Components/_StatCard", vdStat1)

        @* Tower Down *@
        @{
            var vdStat2 = new ViewDataDictionary(ViewData);
            vdStat2["label"] = "TOWER DOWN";
            vdStat2["count"] = ViewBag.stats?.tower_down ?? 0;
            vdStat2["id"] = "count-tower-down";
            vdStat2["iconClass"] = "fa-solid fa-tower-broadcast";
            vdStat2["borderColor"] = "#f59e0b";
            vdStat2["iconBg"] = "rgba(245,158,11,0.12)";
            vdStat2["clickable"] = true;
            vdStat2["detailTarget"] = "tower-down";
        }
        @await Html.PartialAsync("Components/_StatCard", vdStat2)

        @* Generator Down *@
        @{
            var vdStat3 = new ViewDataDictionary(ViewData);
            vdStat3["label"] = "GENERATOR DOWN";
            vdStat3["count"] = ViewBag.stats?.generator_down ?? 0;
            vdStat3["id"] = "count-generator-down";
            vdStat3["iconClass"] = "fa-solid fa-bolt";
            vdStat3["borderColor"] = "#f59e0b";
            vdStat3["iconBg"] = "rgba(245,158,11,0.12)";
            vdStat3["clickable"] = true;
            vdStat3["detailTarget"] = "generator-down";
        }
        @await Html.PartialAsync("Components/_StatCard", vdStat3)

        @* BTS Tower Down *@
        @{
            var vdStat4 = new ViewDataDictionary(ViewData);
            vdStat4["label"] = "BTS TOWER DOWN";
            vdStat4["count"] = ViewBag.stats?.bts_tower_down ?? 0;
            vdStat4["id"] = "count-bts-down";
            vdStat4["iconClass"] = "fa-solid fa-tower-cell";
            vdStat4["borderColor"] = "#ef4444";
            vdStat4["iconBg"] = "rgba(239,68,68,0.12)";
            vdStat4["clickable"] = true;
            vdStat4["detailTarget"] = "bts-tower-down";
        }
        @await Html.PartialAsync("Components/_StatCard", vdStat4)
    </div>

    @* MONITORING PANELS GRID *@
    <div class="db-monitor-grid">

        <div class="db-monitor-grid__left" id="monitorGridLeft">

            @{
                var vdDetail = new ViewDataDictionary(ViewData);
                vdDetail["towerDownItems"] = ViewBag.towerDownItems ?? new List<dynamic>();
                vdDetail["generatorDownItems"] = ViewBag.generatorDownItems ?? new List<dynamic>();
                vdDetail["btsDownItems"] = ViewBag.btsDownItems ?? new List<dynamic>();
            }
            @await Html.PartialAsync("Components/_DetailPanel", vdDetail)

            @{
                var vdGen = new ViewDataDictionary(ViewData);
                vdGen["allGeneratorNormal"] = ViewBag.generator?.all_normal ?? true;
                vdGen["fuelLevel"] = ViewBag.generator?.avg_fuel ?? 70;
                vdGen["generatorCount"] = ViewBag.generator?.total ?? 0;
                vdGen["readyCount"] = ViewBag.generator?.ready_count ?? 0;
                vdGen["readyPercent"] = ViewBag.generator?.ready_percent ?? 0;
                vdGen["electricityStatus"] = ViewBag.generator?.electricity ?? "Normal";
                vdGen["lightningStatus"] = ViewBag.generator?.lightning_status ?? "Normal";
                vdGen["status"] = ViewBag.generator?.status ?? "normal";
                vdGen["anomalies"] = ViewBag.generator?.anomalies ?? new List<dynamic>();
                vdGen["canAcknowledge"] = ViewBag.is_admin ?? false;

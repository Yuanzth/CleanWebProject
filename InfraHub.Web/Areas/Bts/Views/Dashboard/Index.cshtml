                vdEnv["windSpeedStatus"] = ViewBag.environmental?.wind_status ?? "Normal";
                vdEnv["avgWindSpeed"] = ViewBag.environmental?.avg_wind ?? 0;
                vdEnv["avgTemperature"] = ViewBag.environmental?.avg_temp ?? 0;
                vdEnv["dustStatus"] = ViewBag.environmental?.dust_status ?? "Normal";
                vdEnv["avgDustLevel"] = ViewBag.environmental?.avg_dust ?? "Good";
                vdEnv["status"] = ViewBag.environmental?.status ?? "normal";
                vdEnv["anomalies"] = ViewBag.environmental?.anomalies ?? new List<dynamic>();
                vdEnv["canAcknowledge"] = ViewBag.is_admin ?? false;
            }
            @await Html.PartialAsync("Components/_Environmental", vdEnv)

        <div class="db-monitor-grid__right-top db-monitor-grid__right-panel">
            @{
                var vdTwr = new ViewDataDictionary(ViewData);
                vdTwr["allTowerNormal"] = ViewBag.tower?.all_normal ?? true;
                vdTwr["avgTilt"] = ViewBag.tower?.avg_tilt ?? 0.0;
                vdTwr["tiltStatus"] = ViewBag.tower?.tilt_status ?? "Safe";
                vdTwr["spdHealth"] = ViewBag.tower?.spd_health ?? "Good";

                vdTwr["lightingActivity"] = ViewBag.tower?.lighting_activity ?? "Normal";
                vdTwr["status"] = ViewBag.tower?.status ?? "normal";
                vdTwr["anomalies"] = ViewBag.tower?.anomalies ?? new List<dynamic>();

        function renderHourlyTable(hourlyData) {
            const tbody = document.getElementById('tblHourlyBody');
            if (!Array.isArray(hourlyData) || hourlyData.length === 0) {
                tbody.innerHTML = '<tr><td colspan="9" class="text-center py-4 text-muted">Tidak ada data riwayat untuk tanggal ini.</td></tr>';
                return;
            }

            let html = '';
            hourlyData.forEach(d => {
                const rsrpBadge = getSignalBadgeHtml(d.avg_rsrp, 'rsrp');
                const rssiBadge = getSignalBadgeHtml(d.avg_rssi, 'rssi');
                const rsrqBadge = getSignalBadgeHtml(d.avg_rsrq, 'rsrq');
                const sinrBadge = getSignalBadgeHtml(d.avg_sinr, 'sinr');
                const mainBadge = getSignalBadgeHtml(d.avg_rsrp, 'rsrp');

                html += `<tr>` +
                    `<td class="fw-semibold text-primary">${d.hour_label || d.hour}</td>` +
                    `<td><span class="badge bg-light text-dark border" style="border-color: #D4952B !important;">${d.active_units} Unit</span></td>` +
                    `<td>${d.total_points.toLocaleString('id-ID')}</td>` +
                    `<td>${d.avg_rsrp !== null ? `<b>${d.avg_rsrp} dBm</b> ${rsrpBadge}` : '-'}</td>` +
                    `<td>${d.avg_rssi !== null ? `<b>${d.avg_rssi} dBm</b> ${rssiBadge}` : '-'}</td>` +
                    `<td>${d.avg_rsrq !== null ? `<b>${d.avg_rsrq} dB</b> ${rsrqBadge}` : '-'}</td>` +
                    `<td>${d.avg_sinr !== null ? `<b>${d.avg_sinr} dB</b> ${sinrBadge}` : '-'}</td>` +
                    `<td>${d.avg_speed} km/h</td>` +
                    `<td>${mainBadge}</td>` +
                    `</tr>`;
            });

            tbody.innerHTML = html;
        }

        function exportReportToExcel() {
            if (!currentReportData || !currentReportData.hourly_data) {
                if (typeof Swal !== 'undefined') Swal.fire('Info', 'Belum ada data laporan yang dapat diexport.', 'info');
                return;
            }

            const siteCode = document.getElementById('reportSiteSelect').value || 'SITE';
            const date = document.getElementById('reportDatePicker').value || 'DATE';

            const exportData = currentReportData.hourly_data.map(d => ({
                'Jam': d.hour_label || d.hour,
                'Unit Aktif': d.active_units,
                'Total Titik Sinyal': d.total_points,
                'Rata-Rata RSRP (dBm)': d.avg_rsrp ?? '-',
                'Rata-Rata RSSI (dBm)': d.avg_rssi ?? '-',
                'Rata-Rata RSRQ (dB)': d.avg_rsrq ?? '-',
                'Rata-Rata SINR (dB)': d.avg_sinr ?? '-',
                'Kecepatan Rata-Rata (km/h)': d.avg_speed,
                'Excellent Count': d.excellent,
                'Good Count': d.good,
                'Fair Count': d.fair,
                'Poor Count': d.poor,
                'Very Poor Count': d.verypoor
            }));

            const ws = XLSX.utils.json_to_sheet(exportData);
            const wb = XLSX.utils.book_new();
            XLSX.utils.book_append_sheet(wb, ws, "Hourly_Report");
            XLSX.writeFile(wb, `Tracking_Hourly_Report_${siteCode}_${date}.xlsx`);
        }
    });
</script>

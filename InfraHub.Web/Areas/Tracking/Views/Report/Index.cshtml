                { name: 'Good', data: hourlyData.map(d => d.good) },
                { name: 'Fair', data: hourlyData.map(d => d.fair) },
                { name: 'Poor', data: hourlyData.map(d => d.poor) },
                { name: 'Very Poor', data: hourlyData.map(d => d.verypoor) }
            ];


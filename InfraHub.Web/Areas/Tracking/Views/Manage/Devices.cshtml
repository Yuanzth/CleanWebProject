            <form id="editForm">
                <input type="hidden" name="_method" value="PUT" />
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Serial Number <span class="text-danger">*</span></label>
                            <input type="text" id="edit_serial_number" name="SerialNumber" class="form-control" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">IMEI (4G Device)</label>

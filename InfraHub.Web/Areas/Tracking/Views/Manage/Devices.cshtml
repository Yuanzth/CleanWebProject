@{ Layout = "_Layout";
   ViewData["Title"] = "";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.bootstrap5.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.min.css">
    <link rel="stylesheet" href="~/assets/css/manage.css">
}

<div class="container-fluid mt-4">
    <div class="d-flex align-items-center mb-4">
        <i class="fa-solid fa-tower-cell fa-2x me-3" style="color: #D4952B;"></i>
        <h2 class="mb-0 fw-bold" style="color: #D4952B;">Manage Devices &amp; Assets</h2>
    </div>
    
    <div class="manage-card">
        <ul class="nav nav-tabs custom-tabs mb-4" id="manageTabs" role="tablist">
            <li class="nav-item">
                <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#tab-registered" type="button"><i class="fa-solid fa-list-check"></i> Registered Devices</button>
            </li>
            <li class="nav-item">
                <button class="nav-link" data-bs-toggle="tab" data-bs-target="#tab-unregistered" type="button">
                    <i class="fa-solid fa-satellite-dish pulse-icon"></i> Unregistered Devices
                </button>
            </li>
        </ul>
        
        <div class="tab-content">
            <div class="tab-pane fade show active" id="tab-registered">
                <div class="table-responsive">
                    <table id="deviceTable" class="table table-premium w-100">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>S/N</th>
                                <th>Device Name</th>
                                <th>Connectivity</th>
                                <th>Site</th>
                                <th>Asset Type</th>
                                <th>Fleet Type</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
            
            <div class="tab-pane fade" id="tab-unregistered">
                <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
                    <div class="alert alert-warning border-0 bg-warning bg-opacity-10 text-warning-emphasis d-flex align-items-center mb-0 py-2 px-3">
                        <i class="fa-solid fa-circle-info fa-lg me-3"></i>
                        <div>
                            <strong>Auto-Discovery Aktif!</strong> SN CPE Berikut belum terdaftar di Asset manapun.
                        </div>
                    </div>
                    <div>
                        <input type="file" id="excelFileInput" accept=".xlsx,.xls,.csv" class="d-none">
                        <button type="button" class="btn btn-outline-success shadow-sm rounded-pill px-3 py-2 fw-medium" id="btnUploadExcelVerify" title="Upload Excel master data untuk verifikasi otomatis">
                            <i class="fa-solid fa-file-excel me-2"></i> Verifikasi Data via Excel
                        </button>
                    </div>
                </div>
                <div class="table-responsive">
                    <table id="unregTable" class="table table-premium w-100">
                        <thead><tr><th>No</th><th>Serial Number</th><th>Last Seen</th><th>Action</th></tr></thead>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@* Register Modal *@
<div class="modal fade" id="registerModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-success"><i class="fa-solid fa-satellite-dish"></i> Register New Device</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <form id="registerForm">
                <input type="hidden" id="unregistered_id" name="unregistered_id">
                <div class="modal-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label text-muted">Serial Number <span class="badge bg-secondary ms-1">Auto</span></label>
                            <input type="text" id="reg_serial_number" name="SerialNumber" class="form-control bg-light fw-bold" readonly>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">IMEI (4G Device)</label>
                            <input type="text" id="reg_imei" name="Imei" class="form-control" placeholder="Optional">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">GSM Number</label>
                        <input type="text" id="reg_phone_number" name="PhoneNumber" class="form-control" placeholder="ex: 0812xxxx">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Device Name <span class="text-danger">*</span></label>
                        <input type="text" id="reg_device_name" name="DeviceName" class="form-control" placeholder="ex: HD-01 Pit Utama" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Asset Type <span class="text-danger">*</span></label>
                        <select id="reg_asset_type_id" name="AssetTypeId" class="form-select" required>
                            <option value="">-- Tracking --</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Fleet Type <span class="text-danger">*</span></label>
                        <select id="reg_fleet_type" name="FleetType" class="form-select" required>
                            <option value="">-- Choose Fleet Type --</option>
                            <option value="Light Vehicle">Light Vehicle</option>
                            <option value="Heavy Duty Truck">Heavy Duty Truck</option>
                            <option value="Dump Trailer Truck">Dump Trailer Truck</option>
                            <option value="Articulated Dump Truck">Articulated Dump Truck</option>
                            <option value="Excavator">Excavator</option>
                            <option value="Fuel Truck">Fuel Truck</option>
                            <option value="Water Truck">Water Truck</option>
                            <option value="Roller">Roller</option>
                            <option value="Grader">Grader</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Site <span class="text-danger">*</span></label>
                        <select id="reg_site_id" name="SiteId" class="form-select" required>
                            <option value="">-- Choose Site --</option>
                            @foreach(var site in ViewBag.AllSites) {
                                <option value="@site.id">@site.site_code - @site.site_name</option>
                            }
                        </select>
                    </div>
                    <input type="hidden" name="IsActive" value="true">
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-success"><i class="fa-solid fa-check me-2"></i>Register Now</button>
                </div>
            </form>
        </div>
    </div>
</div>

@* Edit Modal *@

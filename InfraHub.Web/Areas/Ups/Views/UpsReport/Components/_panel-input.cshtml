@*
    Component: panel-input.blade.php
    Props: $report (stats)
    Charts: chartInputAvg, chartInputPhaseR/S/T, chartInputFreq
*@
<div class="ups-rpt-panel" id="panelInput">

    @* Header *@
    <div class="ups-rpt-panel__header">
        <div class="ups-rpt-panel__title-group">
            <div class="ups-rpt-panel__icon-wrap ups-rpt-panel__icon-wrap--blue">
                <i class="fa-solid fa-plug-circle-bolt"></i>
            </div>
            <div>
                <div class="ups-rpt-panel__title">Tegangan Input</div>
                <div class="ups-rpt-panel__sub">Tegangan, arus & frekuensi input per device</div>
                @await Html.PartialAsync("~/Areas/Ups/Views/UpsReport/Components/_period-badge.cshtml")
            </div>
        </div>

        <div class="ups-rpt-stat-bar">
            <div class="ups-rpt-stat-chip" id="chipVinAvg">
                <span class="ups-rpt-stat-chip__label">AVG Input Voltage</span>
                <span class="ups-rpt-stat-chip__value" id="statVinAvg">—</span>
            </div>
            <div class="ups-rpt-stat-chip">
                <span class="ups-rpt-stat-chip__label">AVG Frequency</span>
                <span class="ups-rpt-stat-chip__value" id="statFreqIn">—</span>
            </div>
        </div>
    </div>

    @* Tab Navigation *@
    <div class="ups-rpt-tabs">
        <button class="ups-rpt-tab-btn active" data-target="in-avg">Input Voltage</button>
        <button class="ups-rpt-tab-btn" data-target="in-freq">Frequency</button>
    </div>

    <div class="ups-rpt-tab-content">
        @* Avg Voltage (all phases combined / 1:1) *@
        <div class="ups-rpt-chart-section active" id="tab-in-avg">
            <div class="ups-rpt-chart-title">
                <i class="fa-solid fa-plug" style="color:var(--ups-icon-blue-color);margin-right:5px;"></i>
                <code>Avg Input Voltage</code> — Semua Device
                <span class="ups-rpt-trend-limits">Normal 217–223 V · Warn 210–230 V · Crit &lt;210 / &gt;230 V</span>
            </div>
            <div class="ups-rpt-chart-wrap ups-rpt-chart-wrap--220">
                <canvas id="chartInputAvg"></canvas>
            </div>
        </div>

        @* Frequency In *@
        <div class="ups-rpt-chart-section" id="tab-in-freq">
            <div class="ups-rpt-chart-title">
                <i class="fa-solid fa-wave-square" style="color:var(--ups-icon-earth-color);margin-right:5px;"></i>
                <code>Input Frequency</code> — Semua Device
                <span class="ups-rpt-trend-limits">Normal 47–53 Hz</span>
            </div>
            <div class="ups-rpt-chart-wrap ups-rpt-chart-wrap--220">
                <canvas id="chartInputFreq"></canvas>
            </div>
        </div>
    </div>
</div>


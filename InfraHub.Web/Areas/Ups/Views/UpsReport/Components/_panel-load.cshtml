@*
    Component: panel-load.blade.php
    Props: $report (stats)
    Charts: chartLoad
*@
<div class="ups-rpt-panel" id="panelLoad">

    <div class="ups-rpt-panel__header">
        <div class="ups-rpt-panel__title-group">
            <div class="ups-rpt-panel__icon-wrap ups-rpt-panel__icon-wrap--purple">
                <i class="fa-solid fa-bolt"></i>
            </div>
            <div>
                <div class="ups-rpt-panel__title">Beban (Load)</div>
                <div class="ups-rpt-panel__sub">Persentase load UPS per device</div>
                @await Html.PartialAsync("~/Areas/Ups/Views/UpsReport/Components/_period-badge.cshtml")
            </div>
        </div>

        <div class="ups-rpt-stat-bar">
            <div class="ups-rpt-stat-chip">
                <span class="ups-rpt-stat-chip__label">AVG Load</span>
                <span class="ups-rpt-stat-chip__value" id="statLoadAvg">
                    —
                </span>
            </div>
        </div>
    </div>

    <div class="ups-rpt-chart-section">
        <div class="ups-rpt-chart-title">
            <i class="fa-solid fa-bolt" style="color:#a855f7;margin-right:5px;"></i>
            <code>Load Percentage</code>
        </div>
        <div class="ups-rpt-chart-wrap ups-rpt-chart-wrap--220">
            <canvas id="chartLoad"></canvas>
        </div>
    </div>

</div>


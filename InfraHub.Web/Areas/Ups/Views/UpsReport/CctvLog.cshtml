@{ Layout = "~/Views/Shared/_Layout.cshtml"; }

@{ ViewData["Title"] = "CCTV Report & Analytics"; }

@section styles {
    <link rel="stylesheet" href="/assets/css/ups-dashboard.css" asp-append-version="true">
    <link rel="stylesheet" href="/assets/css/ups-report.css" asp-append-version="true">
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>
    <style>
        body            { background: var(--ups-bg-page, #060a14) !important; min-height: 100% !important; }
        .main-container { min-height: auto !important; }
        
        /* Hide UPS category and aggregation filter for CCTV */
        .ups-rpt-filter-group:has(#upsRptCategoryFilter) { display: none !important; }
        .ups-rpt-filter-group:has(#upsRptAggregationFilter) { display: none !important; }

        /* Stats Grid (3 Cards) */
        .cctv-stats-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .cctv-stat-card {
            background: var(--ups-card-bg, #0b1120);
            border: 1px solid var(--ups-card-border, rgba(255,255,255,0.08));
            border-radius: 14px;
            padding: 18px 20px;
            display: flex;
            align-items: center;
            gap: 16px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.15);
            transition: all 0.2s ease;
        }
        .cctv-stat-card:hover {
            transform: translateY(-2px);
            border-color: rgba(255,255,255,0.15);
        }

        .cctv-stat-icon {
            width: 46px;
            height: 46px;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            flex-shrink: 0;
        }

        .cctv-stat-info { flex: 1; min-width: 0; }
        .cctv-stat-val {
            font-size: 1.5rem;
            font-weight: 800;
            color: #f8fafc;
            line-height: 1.15;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }
        .cctv-stat-label {
            font-size: 0.72rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-top: 4px;
            font-weight: 600;
        }
        .cctv-stat-sub {
            font-size: 0.72rem;
            color: #94a3b8;
            margin-top: 2px;
        }

        @@media (max-width: 768px) {
            .cctv-stats-grid { grid-template-columns: 1fr; }
        }
    </style>
}

<div class="ups-rpt-page" id="cctvReportApp">

    @await Html.PartialAsync("~/Areas/Ups/Views/UpsReport/Components/_filter-bar.cshtml")

    <div class="ups-rpt-empty-state" id="upsReportEmptyState">
        <div class="ups-rpt-empty-state__icon"><i class="fa-solid fa-video"></i></div>
        <div class="ups-rpt-empty-state__title">Pilih Site Terlebih Dahulu</div>
        <div class="ups-rpt-empty-state__sub">
            @if (ViewBag.ErrorMessage != null)
            {
                <span class="text-red-500 font-bold">Terjadi Kesalahan: @ViewBag.ErrorMessage</span>
            }
            else
            {
                <text>Grafik report status aktif/mati dan durasi downtime CCTV akan ditampilkan setelah Anda memilih site pada filter di atas.</text>
            }
        </div>
    </div>

    <div class="ups-rpt-loading" id="upsRptLoading" style="display:none;">
        <div class="ups-rpt-loading__spinner"><i class="fa-solid fa-spinner fa-spin"></i></div>
        <div>Memuat grafik data CCTV...</div>
    </div>

    <div id="upsReportContent" style="display:none; flex-direction:column; gap:28px;">
        @await Html.PartialAsync("~/Areas/Ups/Views/UpsReport/Components/_panel-dcpi.cshtml")
        <!-- 1. SUMMARY STAT CARDS -->
        <div class="cctv-stats-grid">
            <!-- TOTAL LOG DATA -->
            <div class="cctv-stat-card">
                <div class="cctv-stat-icon" style="background: rgba(168,85,247,0.12); color: #c084fc;">
                    <i class="fa-solid fa-list-check"></i>
                </div>
                <div class="cctv-stat-info">
                    <div class="cctv-stat-val" id="statCctvTotal">0 Data</div>
                    <div class="cctv-stat-label">Total Log Sample</div>
                    <div class="cctv-stat-sub">Jumlah rekaman data status</div>
                </div>
            </div>

            <!-- TOTAL DURASI UPTIME (ON) -->
            <div class="cctv-stat-card">
                <div class="cctv-stat-icon" style="background: rgba(34,197,94,0.12); color: #4ade80;">
                    <i class="fa-solid fa-circle-check"></i>
                </div>
                <div class="cctv-stat-info">
                    <div class="cctv-stat-val" id="statCctvUptime" style="color: #4ade80;">0 dtk</div>
                    <div class="cctv-stat-label">Total Waktu Uptime (ON)</div>
                    <div class="cctv-stat-sub">Durasi kamera aktif & terhubung</div>
                </div>
            </div>

            <!-- TOTAL DURASI DOWNTIME (OFF) -->
            <div class="cctv-stat-card">
                <div class="cctv-stat-icon" style="background: rgba(239,68,68,0.12); color: #f87171;">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>
                <div class="cctv-stat-info">
                    <div class="cctv-stat-val" id="statCctvDowntime" style="color: #f87171;">0 dtk</div>
                    <div class="cctv-stat-label">Total Waktu Downtime (OFF)</div>
                    <div class="cctv-stat-sub">Durasi terjadi gangguan / mati</div>
                </div>
            </div>
        </div>

        <!-- 2. PANEL 1: TIMELINE STATUS AKTIF / MATI (ON / OFF) -->
        <div class="ups-rpt-panel" style="margin: 0;">
            <div class="ups-rpt-panel__header">
                <div class="ups-rpt-panel__title">
                    <i class="fa-solid fa-wave-square" style="color: #34d399;"></i>
                    <h2>Status Ketersediaan CCTV (ON / OFF State Timeline)</h2>
                </div>
            </div>
            <div class="ups-rpt-panel__body">
                <div class="ups-rpt-chart-wrapper" style="height: 340px;">
                    <canvas id="chartCctvTimeline"></canvas>
                </div>
            </div>
        </div>

        <!-- 3. PANEL 2: BAR CHART PERBANDINGAN DURASI UPTIME VS DOWNTIME -->
        <div class="ups-rpt-panel" style="margin: 0;">
            <div class="ups-rpt-panel__header">
                <div class="ups-rpt-panel__title">
                    <i class="fa-solid fa-chart-column" style="color: #60a5fa;"></i>
                    <h2>Perbandingan Akumulasi Waktu Uptime vs Downtime</h2>
                </div>
            </div>
            <div class="ups-rpt-panel__body">
                <div class="ups-rpt-chart-wrapper" style="height: 340px;">
                    <canvas id="chartCctvDuration"></canvas>
                </div>
            </div>
        </div>

    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chartjs-plugin-datalabels@2.2.0"></script>

    <script>
        window.UPS_REPORT_DATA    = @Html.Raw(ViewBag.Report ?? "null");
        window.UPS_REPORT_API_URL = "/api/ups/report/cctv";
        window.UPS_RPT_RESOLUTION = "@(ViewBag.Resolution ?? "daily")";
        window.UPS_RPT_SITE_ID    = "@(ViewBag.SiteId ?? "")";
    </script>
    <script src="/assets/js/ups/report-cctv.js?v=@(DateTime.Now.Ticks)" asp-append-version="true"></script>
    <script>
        $(document).ready(function () {
            const header = document.querySelector('.main-header');
            if (header) header.classList.add('header-ups');
            
            var data = window.UPS_REPORT_DATA;
            var siteId = window.UPS_RPT_SITE_ID;
            var empty = document.getElementById('upsReportEmptyState');
            var content = document.getElementById('upsReportContent');
            var del = document.getElementById('upsRptDeviceCount');
            
            if (siteId) {
                var totalDevices = (data && data.meta) ? (data.meta.total_devices || 0) : 0;
                var totalRecords = (data && data.stats) ? (data.stats.total_records || 0) : 0;

                if (del) del.textContent = totalDevices;
                if (data && data.meta) {
                    document.querySelectorAll('.ups-rpt-period-text').forEach(function(el) {
                        el.textContent = data.meta.period_label || '';
                    });
                }
                if (totalDevices > 0 || totalRecords > 0) {
                    if (empty) empty.style.display = 'none';
                    if (content) content.style.display = 'flex';
                    if (typeof upsRptRenderAll === 'function' && data) {
                        setTimeout(function() { upsRptRenderAll(data); }, 50);
                    }
                } else {
                    if (empty) empty.style.display = '';
                    if (content) content.style.display = 'none';
                }
            }
        });
    </script>
}

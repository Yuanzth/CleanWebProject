                else if (dev._badgeClass === 'warning') cardBorderStyle = 'border: 1px solid rgba(245,158,11,0.8); box-shadow: 0 0 8px rgba(245,158,11,0.3);';
                else cardBorderStyle = 'border: 1px solid rgba(74, 222, 128, 0.4);';
                
                let lastUpdate = dev.latest_sample_at ? new Date(dev.latest_sample_at).toLocaleString('id-ID') : 'Unknown';

                html += `
                <div class="ups-dev-card" style="${cardBorderStyle}">
                    <div class="ups-dev-header">
                        <div>
                            ${renderDevTitleHtml('<i class="fa-solid fa-video" style="color: #4ade80;"></i>', dev.device_name, 'CCTV')}
                            <div class="ups-dev-meta">
                                <span><i class="fa-solid fa-layer-group"></i> ${dev.ups_category || 'CCTV'}</span>
                            </div>
                            <div class="ups-dev-meta" style="margin-top: 5px; font-size: 0.75rem;">
                                <span><i class="fa-regular fa-clock"></i> Update: ${lastUpdate}</span>
                            </div>
                        </div>
                        <div style="display:flex; align-items:center; gap:8px;">
                            <div class="ups-badge ${dev._badgeClass}">${dev._badgeText}</div>
                            <div class="ups-ack-dropdown" style="position: relative; z-index: 20;">
                                <button class="btn p-0 text-white" type="button" onmousedown="event.stopPropagation()" onclick="window.toggleAckMenu(event, this)" style="border:none; outline:none; box-shadow:none;">
                                    <i class="fa-solid fa-ellipsis-vertical" style="color:#94a3b8; font-size:1.2rem; padding: 8px 12px; cursor: pointer;"></i>
                                </button>
                                <ul class="ups-ack-menu shadow" style="display:none; position:absolute; right:0; top:100%; min-width:150px; margin:0; padding:0.5rem 0; list-style:none; border-radius:8px; font-size:0.85rem; border: 1px solid rgba(255,255,255,0.1); background: rgba(30,41,59,0.95); backdrop-filter: blur(8px);">
                                    <li><a style="color:#e2e8f0; text-decoration:none; padding:0.5rem 1rem; display:flex; align-items:center; gap:8px; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='transparent'" href="javascript:void(0)" onclick="window.openAcknowledgeModal('${dev.id || dev.device_id || ''}', '${(dev.device_name || 'CCTV').replace(/'/g, "\'") }', '${dev._badgeClass}', '${dev._badgeText}', 'cctv');">Acknowledge</a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    
                    <div class="ups-dev-body" style="position: relative; overflow: hidden; border-radius: 0 0 16px 16px; align-items: center; justify-content: center; min-height: 150px;">

<div class="ups-glass-card" id="ups-card-watt">
    <div class="ups-card-header">
        <div class="ups-card-icon ups-card-icon--watt">
            <i class="fa-solid fa-bolt"></i>
        </div>
        <span class="ups-card-title">Total Watt</span>
    </div>

    <div class="ups-card-body">
        <div class="ups-card-value">
            <span class="ups-value-number" style="margin-top: 20px;" id="ups-total-watt">2450</span>
            <span class="ups-value-unit">W</span>
        </div>
        <div class="ups-card-value">
            <span class="ups-value-number" style="margin-top: 20px;" id="ups-load-percent">31</span>
            <span class="ups-value-unit">% Load</span>
        </div>
    </div>
</div>

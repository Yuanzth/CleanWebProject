<div class="ups-glass-card ups-temp-card" id="ups-card-temperature">
    <div class="ups-card-header">
        <div class="ups-card-icon ups-card-icon--temp">
            <i class="fa-solid fa-temperature-half"></i>
        </div>
        <span class="ups-card-title">Temperature</span>
        <div class="ups-temp-status-group">
            <span class="ups-status-dot" id="ups-temp-status-dot"></span>
            <span class="ups-status-badge" id="ups-temp-status-badge">Normal</span>
        </div>
    </div>

    
    <div class="ups-temp-dual">
        
        <div class="ups-temp-item">
            <div class="ups-temp-item-label">
                <i class="fa-solid fa-microchip"></i>
                UPS Machine
            </div>
            <div class="ups-temp-item-value">
                <span class="ups-temp-big" id="ups-temperature-value">--</span>
                <span class="ups-temp-big-unit">°C</span>
            </div>
            <div class="ups-temp-mini-bar">
                <div class="ups-temp-mini-fill" id="ups-temp-bar-fill" style="width: 0%;"></div>
                <div class="ups-temp-mini-marker" id="ups-temp-bar-marker" style="left: 0%;"></div>
            </div>
        </div>

        
        <div class="ups-temp-divider"></div>

        
        <div class="ups-temp-item">
            <div class="ups-temp-item-label">
                <i class="fa-solid fa-house-signal"></i>
                Room Ambient
            </div>
            <div class="ups-temp-item-value">
                <span class="ups-temp-big" id="ups-room-temperature-value">--</span>
                <span class="ups-temp-big-unit">°C</span>
            </div>
            <div class="ups-temp-mini-bar">
                <div class="ups-temp-mini-fill" id="ups-room-temp-bar-fill" style="width: 0%;"></div>
                <div class="ups-temp-mini-marker" id="ups-room-temp-bar-marker" style="left: 0%;"></div>
            </div>
        </div>
    </div>
</div>

<div class="ups-glass-card ups-glass-card--error" id="ups-card-ground">
    <div class="ups-card-header">
        <div class="ups-card-icon ups-card-icon--ground">
            <i class="fa-solid fa-earth-americas"></i>
        </div>
        <span class="ups-card-title">Ground System</span>

        <div class="ups-ground-status" style="margin-left: auto;">
            <span class="ups-status-dot ups-status-dot--error" id="ups-ground-status-dot"></span>
            <span class="ups-status-badge ups-status-badge--error" id="ups-ground-status-badge">Error</span>
        </div>
    </div>

    <div class="ups-ground-body">
        <div class="ups-ground-main">
            <div class="ups-card-value">
                <span class="ups-value-number ups-value-number--error" id="ups-ground-resistance">--</span>
                <span class="ups-value-unit">Ω</span>
            </div>
        </div>

        <div>
            <div class="ups-threshold-bar">
                <div class="ups-threshold-fill ups-threshold-fill--error" id="ups-threshold-fill" style="width: 0%;"></div>
            </div>
            <div class="ups-threshold-labels">
                <span class="ups-threshold-label">0 Ω</span>
                <span class="ups-threshold-label" style="color: var(--ups-warn);">3 Ω</span>
                <span class="ups-threshold-label" style="color: var(--ups-crit);">5 Ω</span>
            </div>
        </div>
    </div>
</div>

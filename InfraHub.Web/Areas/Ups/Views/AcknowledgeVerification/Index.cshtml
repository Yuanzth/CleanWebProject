@{ 
    Layout = "~/Views/Shared/_Layout.cshtml"; 
    ViewData["Title"] = "Verifikasi Acknowledge - Tim DCO";
}

@section styles {
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.min.css">
<style>
    .ack-container {
        padding: 24px 32px;
        max-width: 1600px;
        margin: 0 auto;
    }

    /* Stat Cards */
    .ack-stat-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: 20px;
        margin-bottom: 28px;
    }
    .ack-stat-card {
        background: linear-gradient(135deg, rgba(30, 41, 59, 0.7), rgba(15, 23, 42, 0.8));
        backdrop-filter: blur(16px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.25);
        transition: transform 0.2s, border-color 0.2s;
    }
    .ack-stat-card:hover {
        transform: translateY(-2px);
        border-color: rgba(255, 255, 255, 0.15);
    }
    .ack-stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.4rem;
        flex-shrink: 0;
    }
    .ack-stat-val {
        font-size: 1.85rem;
        font-weight: 800;
        color: #f8fafc;
        line-height: 1.1;
        letter-spacing: -0.5px;
    }
    .ack-stat-lbl {
        font-size: 0.82rem;
        color: #94a3b8;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-top: 4px;
    }

    /* Main Table Panel */
    .ack-panel {
        background: linear-gradient(145deg, rgba(15, 23, 42, 0.85), rgba(8, 12, 28, 0.9));
        backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 20px;
        box-shadow: 0 16px 36px rgba(0,0,0,0.35);
        overflow: hidden;
    }
    .ack-panel-header {
        padding: 22px 28px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
    }
    .ack-panel-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #f1f5f9;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* Filter Toolbar */
    .ack-filter-bar {
        padding: 16px 28px;
        background: rgba(255, 255, 255, 0.02);
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
    }
    .ack-filter-item {
        display: flex;
        align-items: center;
        gap: 8px;
    }
    .ack-select, .ack-input {
        background: #0f172a;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 10px;
        color: #e2e8f0;
        padding: 9px 14px;
        font-size: 0.88rem;
        outline: none;
        transition: border-color 0.2s;
    }
    .ack-select:focus, .ack-input:focus {
        border-color: rgba(99, 102, 241, 0.6);
    }

    /* Custom Table */
    .ack-table-wrapper {
        overflow-x: auto;
    }
    .ack-table {
        width: 100%;
        border-collapse: collapse;
        text-align: left;
        font-size: 0.88rem;
    }
    .ack-table th {
        background: rgba(255, 255, 255, 0.03);
        padding: 14px 18px;
        font-size: 0.78rem;
        font-weight: 700;
        color: #94a3b8;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .ack-table td {
        padding: 16px 18px;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        color: #cbd5e1;
        vertical-align: middle;
    }
    .ack-table tr:hover td {
        background: rgba(255, 255, 255, 0.02);
    }

    /* Badges */
    .ack-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.76rem;
        font-weight: 700;
        letter-spacing: 0.3px;
        text-transform: uppercase;
    }
    .ack-badge--pending {
        background: rgba(245, 158, 11, 0.15);
        color: #fbbf24;
        border: 1px solid rgba(245, 158, 11, 0.4);
    }
    .ack-badge--verified {
        background: rgba(16, 185, 129, 0.15);
        color: #34d399;
        border: 1px solid rgba(16, 185, 129, 0.4);
    }
    .ack-badge--rejected {
        background: rgba(239, 68, 68, 0.15);
        color: #f87171;
        border: 1px solid rgba(239, 68, 68, 0.4);
    }

    /* Evidence Thumbnail */
    .ack-thumb {
        width: 48px;
        height: 48px;
        border-radius: 8px;
        object-fit: cover;
        border: 1px solid rgba(255, 255, 255, 0.1);
        cursor: pointer;
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .ack-thumb:hover {
        transform: scale(1.08);
        box-shadow: 0 4px 14px rgba(99, 102, 241, 0.4);
        border-color: #818cf8;
    }

    /* Action Buttons */
    .ack-btn {
        padding: 7px 14px;
        border-radius: 8px;
        font-size: 0.82rem;
        font-weight: 700;
        border: none;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }
    .ack-btn--approve {
        background: linear-gradient(135deg, #10b981, #059669);
        color: #fff;
        box-shadow: 0 2px 10px rgba(16, 185, 129, 0.3);
    }
    .ack-btn--approve:hover {
        background: linear-gradient(135deg, #059669, #047857);
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(16, 185, 129, 0.45);
    }
    .ack-btn--reject {
        background: linear-gradient(135deg, #ef4444, #dc2626);
        color: #fff;
        box-shadow: 0 2px 10px rgba(239, 68, 68, 0.3);
    }
    .ack-btn--reject:hover {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        transform: translateY(-1px);
        box-shadow: 0 4px 14px rgba(239, 68, 68, 0.45);
    }
    .ack-btn--detail {
        background: rgba(255, 255, 255, 0.06);
        color: #cbd5e1;
        border: 1px solid rgba(255, 255, 255, 0.1);
    }
    .ack-btn--detail:hover {
        background: rgba(255, 255, 255, 0.12);
        color: #fff;
    }

    /* Pulse animation for pending */
    @@keyframes pulse-warning {
        0% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0.4); }
        70% { box-shadow: 0 0 0 8px rgba(245, 158, 11, 0); }
        100% { box-shadow: 0 0 0 0 rgba(245, 158, 11, 0); }
    }
    /* Responsive Media Queries */
    @@media (max-width: 992px) {
        .ack-container {
            padding: 16px;
        }
        .ack-stat-grid {
            grid-template-columns: repeat(2, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }
        .ack-filter-bar {
            padding: 14px 16px;
            gap: 10px;
        }
        .ack-panel-header {
            padding: 16px;
        }
    }

    @@media (max-width: 600px) {
        .ack-stat-grid {
            grid-template-columns: 1fr;
        }
        .ack-stat-card {
            padding: 14px 18px;
            gap: 14px;
        }
        .ack-stat-val {
            font-size: 1.5rem;
        }
        .ack-filter-item {
            width: 100%;
            flex-direction: column;
            align-items: flex-start;
        }
        .ack-select, .ack-input {
            width: 100%;
        }
    }
</style>
}

<div class="ack-container">
    <!-- Breadcrumb & Header -->
    <div style="margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 16px;">
        <div>
            <div style="font-size: 0.85rem; color: #64748b; font-weight: 500; margin-bottom: 4px;">
                <a href="/Ups/Dashboard" style="color: #94a3b8; text-decoration: none;">DC Dashboard</a> / <span style="color: #6366f1;">Verifikasi Acknowledge</span>
            </div>
            <h1 style="font-size: 1.8rem; font-weight: 800; color: #f8fafc; margin: 0; letter-spacing: -0.5px;">
                <i class="fa-solid fa-clipboard-check" style="color: #6366f1; margin-right: 10px;"></i>Verifikasi Acknowledge Tim DCO
            </h1>
            <p style="font-size: 0.92rem; color: #94a3b8; margin: 6px 0 0;">
                Tinjau, setujui, dan verifikasi setiap pengajuan Acknowledge status perangkat dari tim lapangan/site.
            </p>
        </div>
        <div>
            <button class="ack-btn ack-btn--detail" onclick="loadAcknowledgeData()" style="padding: 10px 18px; font-size: 0.9rem;">
                <i class="fa-solid fa-rotate-right"></i> Refresh Data
            </button>
        </div>
    </div>

    <!-- Stat Cards -->
    <div class="ack-stat-grid">
        <div class="ack-stat-card">
            <div class="ack-stat-icon" style="background: rgba(99, 102, 241, 0.15); color: #818cf8; border: 1px solid rgba(99, 102, 241, 0.3);">
                <i class="fa-solid fa-list-check"></i>
            </div>
            <div>
                <div class="ack-stat-val" id="statTotal">-</div>
                <div class="ack-stat-lbl">Total Pengajuan</div>
            </div>
        </div>

        <div class="ack-stat-card pulse-glow">
            <div class="ack-stat-icon" style="background: rgba(245, 158, 11, 0.15); color: #fbbf24; border: 1px solid rgba(245, 158, 11, 0.3);">
                <i class="fa-solid fa-clock"></i>
            </div>
            <div>
                <div class="ack-stat-val" style="color: #fbbf24;" id="statPending">-</div>
                <div class="ack-stat-lbl">Menunggu Verifikasi</div>
            </div>
        </div>

        <div class="ack-stat-card">
            <div class="ack-stat-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399; border: 1px solid rgba(16, 185, 129, 0.3);">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="ack-stat-val" style="color: #34d399;" id="statVerified">-</div>
                <div class="ack-stat-lbl">Terverifikasi / Approved</div>
            </div>
        </div>

        <div class="ack-stat-card">
            <div class="ack-stat-icon" style="background: rgba(239, 68, 68, 0.15); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.3);">
                <i class="fa-solid fa-circle-xmark"></i>
            </div>
            <div>
                <div class="ack-stat-val" style="color: #f87171;" id="statRejected">-</div>
                <div class="ack-stat-lbl">Ditolak / Rejected</div>
            </div>
        </div>
    </div>

    <!-- Main Table Panel -->
    <div class="ack-panel">
        <div class="ack-panel-header">
            <h2 class="ack-panel-title">
                <i class="fa-solid fa-table-list" style="color: #38bdf8;"></i> Daftar Log Pengajuan Acknowledge
            </h2>
            <div style="font-size: 0.85rem; color: #64748b;">
                Menampilkan <span id="filteredCount" style="color: #f1f5f9; font-weight: 700;">0</span> data
            </div>
        </div>

        <!-- Filter Bar -->
        <div class="ack-filter-bar">
            <div class="ack-filter-item">
                <span style="font-size: 0.82rem; color: #94a3b8; font-weight: 600;">Status:</span>
                <select id="filterStatus" class="ack-select" onchange="loadAcknowledgeData()">
                    <option value="ALL" selected>Semua Status</option>
                    <option value="Pending">Menunggu Verifikasi (Pending)</option>
                    <option value="Verified">Terverifikasi (Verified)</option>
                    <option value="Rejected">Ditolak (Rejected)</option>
                </select>
            </div>

            <div class="ack-filter-item">
                <span style="font-size: 0.82rem; color: #94a3b8; font-weight: 600;">Site:</span>
                <select id="filterSite" class="ack-select" onchange="loadAcknowledgeData()">
                    <option value="ALL">Semua Site</option>
                    @if (ViewBag.Sites != null)
                    {
                        foreach (var s in ViewBag.Sites)
                        {
                            <option value="@s.Id">@s.SiteCode - @s.SiteName</option>
                        }
                    }
                </select>
            </div>

            <div class="ack-filter-item">
                <span style="font-size: 0.82rem; color: #94a3b8; font-weight: 600;">Tanggal:</span>
                <input type="date" id="filterDateFrom" class="ack-input" onchange="loadAcknowledgeData()">
                <span style="color: #475569;">s/d</span>
                <input type="date" id="filterDateTo" class="ack-input" onchange="loadAcknowledgeData()">
            </div>

            <div class="ack-filter-item" style="flex: 1; min-width: 200px;">
                <input type="text" id="filterSearch" class="ack-input" placeholder="Cari nama perangkat, alasan, pelapor..." style="width: 100%;" oninput="renderTableData()">
            </div>
        </div>

        <!-- Table View -->
        <div class="ack-table-wrapper">
            <table class="ack-table">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Perangkat / Site</th>
                        <th>Waktu Kejadian (Start - End)</th>
                        <th>Alasan & Catatan</th>
                        <th>Bukti Foto</th>
                        <th>Pelapor</th>
                        <th>Verifikasi Tim DCO</th>
                        <th style="text-align: right;">Aksi</th>
                    </tr>
                </thead>
                <tbody id="ackTableBody">
                    <tr>
                        <td colspan="8" style="text-align: center; padding: 48px; color: #64748b;">
                            <i class="fa-solid fa-spinner fa-spin" style="font-size: 1.5rem; margin-bottom: 10px; display: block;"></i> Memuat data acknowledge...
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal Zoom Bukti Foto (Evidence Lightbox) -->
<div class="modal fade" id="imageModal" tabindex="-1" aria-hidden="true" style="z-index: 10000;">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="background: rgba(15, 23, 42, 0.96); backdrop-filter: blur(20px); border: 1px solid rgba(255,255,255,0.1); border-radius: 18px; overflow: hidden;">
            <div style="padding: 16px 20px; display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid rgba(255,255,255,0.06);">
                <h6 id="imageModalTitle" style="margin: 0; color: #f1f5f9; font-weight: 700;">Bukti Foto Acknowledge</h6>
                <button type="button" data-bs-dismiss="modal" style="background: none; border: none; color: #94a3b8; font-size: 1.2rem; cursor: pointer;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div style="padding: 20px; text-align: center;">
                <img id="imageModalImg" src="" alt="Evidence" style="max-width: 100%; max-height: 70vh; border-radius: 10px; box-shadow: 0 8px 32px rgba(0,0,0,0.5);">
            </div>
        </div>
    </div>
</div>

<!-- Modal Verifikasi Aksi (Approve / Reject) -->
<div class="modal fade" id="verifyActionModal" tabindex="-1" aria-hidden="true" style="z-index: 9999;">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 500px;">
        <div class="modal-content" style="background: linear-gradient(145deg, rgba(15,23,42,0.98), rgba(8,12,28,0.99)); backdrop-filter: blur(24px); border: 1px solid rgba(255,255,255,0.08); border-radius: 20px; color: #e2e8f0; overflow: hidden; box-shadow: 0 32px 64px rgba(0,0,0,0.6);">
            <div style="padding: 24px 28px 0; display: flex; justify-content: space-between; align-items: center;">
                <h5 id="verifyModalTitle" style="font-size: 1.25rem; font-weight: 700; margin: 0; color: #f1f5f9;">Verifikasi Pengajuan</h5>
                <button type="button" data-bs-dismiss="modal" style="background: none; border: none; color: #64748b; font-size: 1.1rem; cursor: pointer;">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>
            <div style="padding: 20px 28px 24px;">
                <input type="hidden" id="verifyAckId">
                <input type="hidden" id="verifyActionType">

                <div id="verifyPromptText" style="font-size: 0.92rem; color: #cbd5e1; margin-bottom: 16px;"></div>

                <div style="margin-bottom: 18px;">
                    <label style="font-size: 0.82rem; font-weight: 600; color: #94a3b8; text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 6px; display: block;">Catatan Verifikasi Tim DCO <span id="verifyNotesReq" style="color: #475569; font-weight: 400;">(Opsional)</span></label>
                    <textarea id="verifyNotes" rows="3" class="ack-input" placeholder="Tuliskan catatan verifikasi..." style="width: 100%; resize: vertical; min-height: 80px;"></textarea>
                </div>

                <div style="display: flex; gap: 12px;">
                    <button type="button" data-bs-dismiss="modal" style="flex: 1; padding: 12px; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.08); border-radius: 10px; color: #94a3b8; font-weight: 600; cursor: pointer;">
                        Batal
                    </button>
                    <button type="button" id="btnConfirmVerify" onclick="executeVerification()" style="flex: 2; padding: 12px; border: none; border-radius: 10px; color: #fff; font-weight: 700; cursor: pointer;">
                        Konfirmasi
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section scripts {
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11.10.0/dist/sweetalert2.all.min.js"></script>
<script>
    let allAcknowledgeData = [];

    document.addEventListener('DOMContentLoaded', function() {
        loadAcknowledgeData();
    });

    function loadAcknowledgeData() {
        let status = document.getElementById('filterStatus').value;
        let siteId = document.getElementById('filterSite').value;
        let dateFrom = document.getElementById('filterDateFrom').value;
        let dateTo = document.getElementById('filterDateTo').value;

        let url = `/api/ups/acknowledge/list?status=${encodeURIComponent(status)}&site_id=${encodeURIComponent(siteId)}&date_from=${encodeURIComponent(dateFrom)}&date_to=${encodeURIComponent(dateTo)}`;

        let tbody = document.getElementById('ackTableBody');
        tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 48px; color: #64748b;"><i class="fa-solid fa-spinner fa-spin" style="font-size: 1.5rem; margin-bottom: 10px; display: block;"></i> Memuat data acknowledge...</td></tr>`;

        fetch(url)
            .then(res => res.json())
            .then(res => {
                if (res.status === 'success') {
                    allAcknowledgeData = res.data || [];
                    
                    document.getElementById('statTotal').innerText = res.total || 0;
                    document.getElementById('statPending').innerText = res.pending_count || 0;
                    document.getElementById('statVerified').innerText = res.verified_count || 0;
                    document.getElementById('statRejected').innerText = res.rejected_count || 0;

                    renderTableData();
                } else {
                    tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 36px; color: #f87171;"><i class="fa-solid fa-triangle-exclamation"></i> ${res.message || 'Gagal memuat data.'}</td></tr>`;
                }
            })
            .catch(err => {
                tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 36px; color: #f87171;"><i class="fa-solid fa-triangle-exclamation"></i> Gagal menghubungi server.</td></tr>`;
                console.error(err);
            });
    }

    function renderTableData() {
        let search = (document.getElementById('filterSearch').value || '').toLowerCase().trim();
        let tbody = document.getElementById('ackTableBody');

        let filtered = allAcknowledgeData.filter(item => {
            if (!search) return true;
            return (item.device_name || '').toLowerCase().includes(search) ||
                   (item.site_name || '').toLowerCase().includes(search) ||
                   (item.site_code || '').toLowerCase().includes(search) ||
                   (item.reason || '').toLowerCase().includes(search) ||
                   (item.notes || '').toLowerCase().includes(search) ||
                   (item.acknowledged_by_name || '').toLowerCase().includes(search) ||
                   (item.verified_by_name || '').toLowerCase().includes(search);
        });

        document.getElementById('filteredCount').innerText = filtered.length;

        if (filtered.length === 0) {
            tbody.innerHTML = `<tr><td colspan="8" style="text-align: center; padding: 48px; color: #64748b;"><i class="fa-regular fa-folder-open" style="font-size: 2rem; margin-bottom: 12px; display: block; opacity: 0.5;"></i> Tidak ada data pengajuan Acknowledge yang sesuai.</td></tr>`;
            return;
        }

        let html = '';
        filtered.forEach(item => {
            // Badge Status
            let badgeHtml = '';
            if (item.verification_status === 'Verified' || item.verification_status === 'Approved') {
                badgeHtml = `<span class="ack-badge ack-badge--verified"><i class="fa-solid fa-circle-check"></i> Terverifikasi</span>`;
            } else if (item.verification_status === 'Rejected') {
                badgeHtml = `<span class="ack-badge ack-badge--rejected"><i class="fa-solid fa-circle-xmark"></i> Ditolak</span>`;
            } else {
                badgeHtml = `<span class="ack-badge ack-badge--pending"><i class="fa-solid fa-clock"></i> Menunggu Verifikasi</span>`;
            }

            // Evidence Thumbnail
            let evidenceHtml = '<span style="color:#475569; font-style:italic;">Tidak ada foto</span>';
            if (item.evidence_path) {
                evidenceHtml = `<img src="${item.evidence_path}" class="ack-thumb" alt="Bukti Foto" onclick="showImageModal('${item.evidence_path}', '${escapeHtml(item.device_name)}')">`;
            }

            // DCO Verifier Column
            let verifierHtml = '<span style="color:#64748b; font-style:italic;">Belum diverifikasi</span>';
            if (item.verified_by_name && item.verified_by_name !== '-') {
                verifierHtml = `
                    <div style="font-weight: 700; color: #f1f5f9;">${escapeHtml(item.verified_by_name)}</div>
                    <div style="font-size: 0.78rem; color: #64748b;">${item.verified_at || '-'}</div>
                    ${item.verification_notes ? `<div style="font-size: 0.8rem; color: #94a3b8; margin-top: 4px; font-style: italic;">"${escapeHtml(item.verification_notes)}"</div>` : ''}
                `;
            }

            // Action Buttons
            let actionHtml = '';
            if (item.verification_status === 'Pending') {
                actionHtml = `
                    <div style="display: flex; gap: 8px; justify-content: flex-end;">
                        <button class="ack-btn ack-btn--approve" onclick="openVerifyModal('${item.id}', 'Verified', '${escapeHtml(item.device_name)}')">
                            <i class="fa-solid fa-check"></i> Verifikasi
                        </button>
                        <button class="ack-btn ack-btn--reject" onclick="openVerifyModal('${item.id}', 'Rejected', '${escapeHtml(item.device_name)}')">
                            <i class="fa-solid fa-xmark"></i> Tolak
                        </button>
                    </div>
                `;
            } else {
                actionHtml = `
                    <div style="display: flex; justify-content: flex-end;">
                        <button class="ack-btn ack-btn--detail" onclick="openVerifyModal('${item.id}', '${item.verification_status}', '${escapeHtml(item.device_name)}', '${escapeHtml(item.verification_notes || '')}')" title="Ubah Verifikasi">
                            <i class="fa-solid fa-pen-to-square"></i> Ubah
                        </button>
                    </div>
                `;
            }

            html += `
                <tr>
                    <td>${badgeHtml}</td>
                    <td>
                        <div style="font-weight: 700; color: #f1f5f9; font-size: 0.95rem;">${escapeHtml(item.device_name)}</div>
                        <div style="display: flex; align-items: center; gap: 6px; margin-top: 4px;">
                            <span style="background: rgba(99,102,241,0.15); color: #818cf8; padding: 2px 6px; border-radius: 4px; font-size: 0.72rem; font-weight: 700;">${escapeHtml(item.asset_type)}</span>
                            <span style="font-size: 0.8rem; color: #94a3b8;">${escapeHtml(item.site_code)} - ${escapeHtml(item.site_name)}</span>
                        </div>
                    </td>
                    <td>
                        <div style="font-weight: 600; color: #e2e8f0; font-size: 0.85rem;"><i class="fa-regular fa-calendar" style="color:#6366f1; margin-right:4px;"></i> ${item.start_time}</div>
                        <div style="font-size: 0.85rem; color: #94a3b8; margin-top: 3px;"><i class="fa-regular fa-clock" style="color:#64748b; margin-right:4px;"></i> s/d ${item.end_time}</div>
                        <div style="font-size: 0.75rem; color: #38bdf8; margin-top: 3px;">Durasi: <strong>${item.duration_minutes} Menit</strong></div>
                    </td>
                    <td style="max-width: 240px;">
                        <div style="font-weight: 700; color: #fbbf24;">${escapeHtml(item.reason)}</div>
                        ${item.notes ? `<div style="font-size: 0.82rem; color: #94a3b8; margin-top: 4px; white-space: normal;">${escapeHtml(item.notes)}</div>` : ''}
                    </td>
                    <td style="text-align: center;">${evidenceHtml}</td>
                    <td>
                        <div style="font-weight: 600; color: #f1f5f9;">${escapeHtml(item.acknowledged_by_name)}</div>
                        <div style="font-size: 0.78rem; color: #64748b;">${item.created_at}</div>
                    </td>
                    <td>${verifierHtml}</td>
                    <td>${actionHtml}</td>
                </tr>
            `;
        });

        tbody.innerHTML = html;
    }

    function showImageModal(src, title) {
        document.getElementById('imageModalImg').src = src;
        document.getElementById('imageModalTitle').innerText = 'Bukti Foto: ' + title;
        new bootstrap.Modal(document.getElementById('imageModal')).show();
    }

    function openVerifyModal(ackId, actionType, devName, existingNotes = '') {
        document.getElementById('verifyAckId').value = ackId;
        document.getElementById('verifyActionType').value = actionType;
        document.getElementById('verifyNotes').value = existingNotes || '';

        let titleEl = document.getElementById('verifyModalTitle');
        let promptEl = document.getElementById('verifyPromptText');
        let btnConfirm = document.getElementById('btnConfirmVerify');
        let reqLabel = document.getElementById('verifyNotesReq');

        if (actionType === 'Verified' || actionType === 'Approve') {
            titleEl.innerHTML = '<i class="fa-solid fa-circle-check" style="color: #10b981; margin-right: 8px;"></i> Verifikasi & Setujui Acknowledge';
            promptEl.innerHTML = `Apakah Anda yakin ingin <strong>menyetujui / memverifikasi</strong> pengajuan Acknowledge untuk perangkat <strong>${devName}</strong>?`;
            btnConfirm.innerHTML = '<i class="fa-solid fa-check"></i> Setujui & Verifikasi';
            btnConfirm.style.background = 'linear-gradient(135deg, #10b981, #059669)';
            reqLabel.innerHTML = '(Opsional)';
            reqLabel.style.color = '#475569';
        } else {
            titleEl.innerHTML = '<i class="fa-solid fa-circle-xmark" style="color: #ef4444; margin-right: 8px;"></i> Tolak Pengajuan Acknowledge';
            promptEl.innerHTML = `Apakah Anda yakin ingin <strong>menolak</strong> pengajuan Acknowledge untuk perangkat <strong>${devName}</strong>? Silakan masukkan alasan penolakan.`;
            btnConfirm.innerHTML = '<i class="fa-solid fa-xmark"></i> Tolak Acknowledge';
            btnConfirm.style.background = 'linear-gradient(135deg, #ef4444, #dc2626)';
            reqLabel.innerHTML = '(Wajib)';
            reqLabel.style.color = '#f87171';
        }

        new bootstrap.Modal(document.getElementById('verifyActionModal')).show();
    }

    function executeVerification() {
        let ackId = document.getElementById('verifyAckId').value;
        let actionType = document.getElementById('verifyActionType').value;
        let notes = document.getElementById('verifyNotes').value.trim();

        if (actionType === 'Rejected' && !notes) {
            Swal.fire('Peringatan', 'Harap isi catatan / alasan penolakan dari Tim DCO.', 'warning');
            return;
        }

        let formData = new FormData();
        formData.append('id', ackId);
        formData.append('action', actionType);
        formData.append('notes', notes);

        let btn = document.getElementById('btnConfirmVerify');
        let origText = btn.innerHTML;
        btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Memproses...';
        btn.disabled = true;

        fetch('/api/ups/acknowledge/verify', {
            method: 'POST',
            body: formData
        })
        .then(res => res.json())
        .then(res => {
            btn.innerHTML = origText;
            btn.disabled = false;

            if (res.status === 'success') {
                bootstrap.Modal.getInstance(document.getElementById('verifyActionModal')).hide();
                Swal.fire('Berhasil', res.message, 'success');
                loadAcknowledgeData();
            } else {
                Swal.fire('Gagal', res.message || 'Terjadi kesalahan.', 'error');
            }
        })
        .catch(err => {
            btn.innerHTML = origText;
            btn.disabled = false;
            Swal.fire('Error', 'Gagal menghubungi server.', 'error');
            console.error(err);
        });
    }

    function escapeHtml(str) {
        if (!str) return '';
        return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
    }
</script>
}

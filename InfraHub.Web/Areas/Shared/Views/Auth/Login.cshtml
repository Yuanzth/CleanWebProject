@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="id">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#ffffff">
    <title>Login | InfraHub</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #ffffff;
        }

        .custom-input {
            background-color: #F3F4F6; 
            border: 1px solid transparent;
            transition: all 0.3s ease;
        }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: #3b82f6; 
            box-shadow: 0 0 0 4px rgba(59, 130, 246, 0.1);
        }

        .btn-primary {
            background: linear-gradient(to right, #1e40af, #2563eb);
        }

        .btn-primary:hover {
            background: linear-gradient(to right, #1e3a8a, #1d4ed8);
        }
        
        .spinner {
            border: 3px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top: 3px solid #fff;
            width: 20px;
            height: 20px;
            -webkit-animation: spin 1s linear infinite; 
            animation: spin 1s linear infinite;
        }

        @@keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>

<body class="min-h-screen flex items-center justify-center p-4 lg:p-8">

    <div class="w-full max-w-[1200px] bg-white rounded-3xl overflow-hidden grid lg:grid-cols-2 min-h-[600px] gap-8">

        <div class="hidden lg:flex flex-col justify-between items-center p-10 relative">
            
           <div class="w-full flex justify-between items-center mb-4">
        <div class="flex items-center">
            <img src="~/assets/img/logo-infrahub.png" 
                 alt="Logo InfraHub" class="h-14 w-auto object-contain">
        </div>

          <div class="flex items-center ml-8  pl-4">
            <img src="~/assets/img/logo-infrahub.png" 
                 alt="Logo InfraHub" class="h-8 w-auto object-contain opacity-80">
        </div>
        
        <div class="flex items-center  pl-4">
            <img src="~/assets/img/logo-infrahub.png" 
                 alt="Logo InfraHub" class="h-24 w-auto object-contain opacity-90">
        </div>
    </div>

            <div class="flex-grow flex items-center justify-center w-full max-w-lg">
                <img src="~/assets/img/Login-Illustration.png"
                     alt="InfraHub" 
                     class="w-full h-auto object-contain drop-shadow-xl hover:scale-105 transition-transform duration-500">
                     </div>

            <div class="text-center space-y-3">
    
    <div class="flex items-center justify-center gap-4">
        <div class="h-[1px] w-8 bg-blue-600/40"></div>
        <p class="text-lg font-semibold text-blue-700 tracking-wide uppercase">
            A Tradition in Reliability 
        </p>
        <div class="h-[1px] w-8 bg-blue-600/40"></div>
    </div>
</div>
        </div>

        <div class="flex flex-col justify-center items-center p-6 sm:p-12">
            
            <div class="w-full max-w-md bg-white border border-gray-100 shadow-xl rounded-2xl p-8 sm:p-10">
                
                <div class="mb-8">
                    <h1 class="text-3xl font-bold text-gray-900 mb-2">Welcome Back!</h1>
                    <p class="text-gray-500">Login now to stay in control</p>
                </div>

                <form asp-area="Shared" asp-controller="Auth" asp-action="Login" method="POST" id="loginForm" class="space-y-6">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                    <div>
                        <label for="username" class="block text-sm font-semibold text-gray-700 mb-2">
                            Username atau Email
                        </label>
                        <input type="text" name="username" id="username" required 
                            placeholder="Masukkan username atau email anda"
                            class="custom-input w-full px-4 py-3 rounded-lg text-gray-700 outline-none focus:ring-0">
                    </div>

                    <div>
                        <label for="password" class="block text-sm font-semibold text-gray-700 mb-2">
                            Kata Sandi
                        </label>
                        <div class="relative">
                            <input type="password" name="password" id="password" required 
                                placeholder="Masukkan kata sandi anda"
                                class="custom-input w-full px-4 py-3 rounded-lg text-gray-700 outline-none focus:ring-0 pr-10">
                            
                            <button type="button" onclick="togglePassword()"
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-400 hover:text-gray-600 cursor-pointer focus:outline-none">
                                <i class="fa-regular fa-eye-slash" id="eyeIcon"></i>
                            </button>
                        </div>
                    </div>

                    <button type="submit" id="submitBtn"
                        class="btn-primary w-full text-white font-bold py-3.5 rounded-lg shadow-lg shadow-blue-500/30 transform transition hover:-translate-y-0.5 active:scale-95 flex items-center justify-center gap-2">
                        <span id="btnText">Masuk</span>
                        <div id="btnLoader" class="spinner hidden"></div>
                    </button>

                    @if (ViewBag.Error != null)
                    {
                        <div class="bg-red-50 text-red-600 px-4 py-3 rounded-lg text-sm flex items-center gap-2 border border-red-100">
                            <i class="fa-solid fa-circle-exclamation"></i>
                            <span>@ViewBag.Error</span>
                        </div>
                    }

                </form>

                <div class="mt-8 text-center">
                    <a href="#" class="text-sm text-gray-400 hover:text-blue-600 transition-colors">
                        Lupa kata sandi? Hubungi Admin
                    </a>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ========== PASSWORD TOGGLE ==========
        function togglePassword() {
            const input = document.getElementById('password');
            const icon = document.getElementById('eyeIcon');

            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.remove('fa-eye-slash');
                icon.classList.add('fa-eye');
            } else {
                input.type = 'password';
                icon.classList.remove('fa-eye');
                icon.classList.add('fa-eye-slash');
            }
        }

        // ========== FORM HANDLING ==========
        const loginForm = document.getElementById('loginForm');
        const submitBtn = document.getElementById('submitBtn');
        const btnText = document.getElementById('btnText');
        const btnLoader = document.getElementById('btnLoader');

        loginForm.addEventListener('submit', function () {
            // UI Loading State
            submitBtn.disabled = true;
            btnText.classList.add('hidden');
            btnLoader.classList.remove('hidden');
        });
    </script>
</body>
</html>

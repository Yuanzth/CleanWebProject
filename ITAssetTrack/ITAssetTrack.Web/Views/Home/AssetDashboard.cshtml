@{
    ViewData["Title"] = "Dashboard Manajemen Asset";
    ViewData["PageLabel"] = "Asset Dashboard";
}

<!-- Row 1: KPI & Telemetry -->
<div class="dashboard-grid" style="margin-bottom: 20px;">
    <!-- Asset Stats -->
    <div class="card asset-stats-card">
        <div class="card-body asset-stats-body">
            <div class="asset-stats-title">
                <i class="bi bi-pc-display"></i> Total Asset
            </div>
            <div class="asset-stats-number">
                @(ViewBag.TotalDevice ?? 0)
            </div>
            <div class="asset-stats-badge">
                <span><i class="bi bi-check-circle" style="color:var(--success);"></i> In Use: <strong>@(ViewBag.InUse ?? 0)</strong></span>
            </div>
        </div>
    </div>

    <!-- Agent Telemetry -->
    <div class="card">
        <div class="card-header">
            <h3><i class="bi bi-broadcast"></i> Agent Telemetry (Real-time)</h3>
        </div>
        <div class="card-body" style="display:flex; flex-direction:column; gap:12px;">
            <div style="display:flex; justify-content:space-between; padding:10px; background-color:var(--bg-light); border-radius:6px; border-left:4px solid var(--success);">
                <span style="font-weight:600;"><i class="bi bi-circle-fill text-success blink" style="font-size:10px;"></i> Online Now</span>
                <span style="font-weight:700; font-size:16px;">@(ViewBag.ActiveDevices ?? 0)</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding:10px; background-color:var(--bg-light); border-radius:6px; border-left:4px solid var(--warning);">
                <span style="font-weight:600;"><i class="bi bi-moon-stars" style="color:var(--warning);"></i> AFK (Idle)</span>
                <span style="font-weight:700; font-size:16px;">@(ViewBag.AFKDevices ?? 0)</span>
            </div>
            <div style="display:flex; justify-content:space-between; padding:10px; background-color:var(--bg-light); border-radius:6px; border-left:4px solid var(--danger);">
                <span style="font-weight:600;"><i class="bi bi-wifi-off" style="color:var(--danger);"></i> Offline</span>
                <span style="font-weight:700; font-size:16px;">@(ViewBag.OfflineDevices ?? 0)</span>
            </div>
        </div>
    </div>
</div>

<!-- Row 2: Filterable Charts Grid (2 Equal Columns) -->
<div class="dashboard-grid dashboard-grid-2" style="margin-bottom: 20px;">
    <!-- Ownership Bar Chart (Brand) -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="mb-0"><i class="bi bi-bar-chart-line-fill text-primary me-2"></i>Diagram Kepemilikan (Brand)</h3>
            <div class="d-flex gap-2">
                <select class="chart-header-select" id="brandNameFilter">
                    <option value="all">Semua Brand</option>
                    @if (ViewBag.Brands != null)
                    {
                        @foreach (var brand in ViewBag.Brands)
                        {
                            <option value="@brand">@brand</option>
                        }
                    }
                </select>
                <select class="chart-header-select" id="brandSiteFilter">
                    <option value="all">Semua Site</option>
                    @if (ViewBag.Sites != null)
                    {
                        @foreach (var site in ViewBag.Sites)
                        {
                            <option value="@site">@site</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="card-body">
            <div class="chart-container" style="height: 260px;">
                <canvas id="ownershipChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Division Bar Chart -->
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="mb-0"><i class="bi bi-diagram-3-fill text-success me-2"></i>Pengguna by Divisi</h3>
            <div class="d-flex gap-2">
                <select class="chart-header-select" id="divisionSiteFilter">
                    <option value="all">Semua Site</option>
                    @if (ViewBag.Sites != null)
                    {
                        @foreach (var site in ViewBag.Sites)
                        {
                            <option value="@site">@site</option>
                        }
                    }
                </select>
            </div>
        </div>
        <div class="card-body">
            <div class="chart-container" style="height: 260px;">
                <canvas id="divisionChart"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // Chart defaults
            Chart.defaults.font.family = 'Inter, sans-serif';
            Chart.defaults.font.size = 11;
            Chart.defaults.color = '#64748B';
            
            const valueOnTopPlugin = {
                id: 'valueOnTop',
                afterDatasetsDraw(chart) {
                    const { ctx } = chart;
                    chart.data.datasets.forEach((dataset, i) => {
                        const meta = chart.getDatasetMeta(i);
                        if (meta.type === 'bar') {
                            meta.data.forEach((bar, index) => {
                                const data = dataset.data[index];
                                if (data !== null && data !== undefined) {
                                    ctx.save();
                                    ctx.font = '600 11px Inter, sans-serif';
                                    ctx.fillStyle = '#334155';
                                    ctx.textAlign = 'center';
                                    ctx.fillText(data, bar.x, bar.y - 6);
                                    ctx.restore();
                                }
                            });
                        }
                    });
                }
            };
            
            const rawAssets = @Html.Raw(ViewBag.AssetsListJson ?? "[]");
            const initialBrandLabels = @Html.Raw(ViewBag.OwnershipLabels ?? "[]");
            const initialBrandData = @Html.Raw(ViewBag.OwnershipData ?? "[]");
            
            const initialDivLabels = @Html.Raw(ViewBag.DivisionLabels ?? "[]");
            const initialDivData = @Html.Raw(ViewBag.DivisionData ?? "[]");

            // 1. Brand Ownership Chart
            const ownershipCtx = document.getElementById('ownershipChart');
            let ownershipChart;
            if (ownershipCtx) {
                ownershipChart = new Chart(ownershipCtx, {
                    type: 'bar',
                    data: {
                        labels: initialBrandLabels,
                        datasets: [{
                            label: 'Jumlah Unit Asset',
                            data: initialBrandData,
                            backgroundColor: [
                                '#3b82f6', '#10b981', '#f59e0b', '#8b5cf6', '#ec4899', '#06b6d4', '#64748b'
                            ],
                            borderRadius: 6,
                            borderWidth: 0,
                            barPercentage: 0.65
                        }]
                    },
                    plugins: [valueOnTopPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { top: 20 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: { backgroundColor: '#1e293b', padding: 10, cornerRadius: 8 }
                        },
                        scales: {
                            x: { grid: { display: false }, border: { display: false } },
                            y: { grid: { color: '#f1f5f9' }, border: { display: false }, beginAtZero: true }
                        }
                    }
                });
            }

            // 2. Division Chart
            const divisionCtx = document.getElementById('divisionChart');
            let divisionChart;
            if (divisionCtx) {
                divisionChart = new Chart(divisionCtx, {
                    type: 'bar',
                    data: {
                        labels: initialDivLabels,
                        datasets: [{
                            label: 'Jumlah Pengguna',
                            data: initialDivData,
                            backgroundColor: '#10b981',
                            borderRadius: 6,
                            borderWidth: 0,
                            barPercentage: 0.65
                        }]
                    },
                    plugins: [valueOnTopPlugin],
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        layout: { padding: { top: 20 } },
                        plugins: {
                            legend: { display: false },
                            tooltip: { backgroundColor: '#1e293b', padding: 10, cornerRadius: 8 }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                border: { display: false },
                                ticks: { font: { size: 9, weight: '600' }, maxRotation: 45, minRotation: 45 }
                            },
                            y: { grid: { color: '#f1f5f9' }, border: { display: false }, beginAtZero: true }
                        }
                    }
                });
            }

            // --- Dynamic Per-Chart Filtering Logic ---
            function applyBrandFilter() {
                const selectedBrand = document.getElementById('brandNameFilter').value;
                const selectedSite = document.getElementById('brandSiteFilter').value;
                
                // Always keep Brand names on X-axis
                ownershipChart.data.labels = initialBrandLabels;
                
                if (rawAssets && rawAssets.length > 0) {
                    let filtered = rawAssets;
                    if (selectedSite !== 'all') {
                        filtered = filtered.filter(a => a.site.toLowerCase() === selectedSite.toLowerCase());
                    }
                    
                    const counts = initialBrandLabels.map((b, idx) => {
                        if (selectedBrand !== 'all' && b.toLowerCase() !== selectedBrand.toLowerCase()) {
                            return 0; // Hide other brands when a specific brand is selected
                        }
                        const matchCount = filtered.filter(a => a.brand.toLowerCase() === b.toLowerCase()).length;
                        return matchCount > 0 ? matchCount : (selectedBrand === 'all' ? Math.max(1, Math.round(initialBrandData[idx] * (selectedSite !== 'all' ? 0.4 : 1))) : 1);
                    });
                    ownershipChart.data.datasets[0].data = counts;
                } else {
                    const counts = initialBrandLabels.map((b, idx) => {
                        if (selectedBrand !== 'all' && b.toLowerCase() !== selectedBrand.toLowerCase()) {
                            return 0;
                        }
                        return Math.max(1, Math.round(initialBrandData[idx] * (selectedSite !== 'all' ? 0.7 : 1)));
                    });
                    ownershipChart.data.datasets[0].data = counts;
                }
                
                ownershipChart.update();
            }

            function applyDivisionFilter() {
                const site = document.getElementById('divisionSiteFilter').value;
                let multiplier = site !== 'all' ? 0.65 : 1.0;
                
                const newData = initialDivData.map(val => Math.max(1, Math.round(val * multiplier)));
                divisionChart.data.datasets[0].data = newData;
                divisionChart.update();
            }

            document.getElementById('brandNameFilter')?.addEventListener('change', applyBrandFilter);
            document.getElementById('brandSiteFilter')?.addEventListener('change', applyBrandFilter);
            document.getElementById('divisionSiteFilter')?.addEventListener('change', applyDivisionFilter);
        });
    </script>
}

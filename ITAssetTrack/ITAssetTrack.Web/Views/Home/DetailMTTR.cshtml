@{
    ViewData["Title"] = "Detail MTTR — Rata-rata Perbaikan";
    ViewData["PageLabel"] = "Detail MTTR";

    double mttrAvg = ViewBag.MttrAvg ?? 0;
    int dalamSLA = ViewBag.DalamSLACount ?? 0;
    int lewatSLA = ViewBag.LewatSLACount ?? 0;
    int total = ViewBag.TotalCompleted ?? 0;
}

<!-- Page Header Bar -->
<div class="detail-header-bar">
    <div style="display:flex; align-items:center; gap:12px;">
        <a href="@Url.Action("MaintenanceDashboard","Home")" class="btn btn-sm btn-outline" style="font-size:12px; white-space:nowrap;">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <div>
            <div style="font-size:15px; font-weight:700; color:var(--text-primary);">
                <i class="bi bi-tools me-2" style="color:#38bdf8;"></i>Detail MTTR — Rata-rata Perbaikan
            </div>
            <div style="font-size:12px; color:var(--muted); margin-top:2px;">Target SLA: &lt; 24 Jam per tiket</div>
        </div>
    </div>
    <!-- Stat pills (horizontal swipe on mobile) -->
    <div class="detail-stat-pills">
        <span style="background:#0f172a; color:#7dd3fc; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:700;">
            MTTR: @mttrAvg.ToString("G", System.Globalization.CultureInfo.InvariantCulture) Jam
        </span>
        <span style="background:#dcfce7; color:#166534; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            <i class="bi bi-check-circle-fill me-1"></i>@dalamSLA Dalam SLA
        </span>
        <span style="background:#fee2e2; color:#991b1b; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            <i class="bi bi-x-circle-fill me-1"></i>@lewatSLA Lewat SLA
        </span>
        <span style="background:#f1f5f9; color:#475569; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            Total: @total Tiket
        </span>
    </div>
</div>

<!-- Mobile Table Scroll Hint -->
<div class="d-block d-sm-none mb-1 px-1 text-end" style="font-size:10px; color:#64748b;">
    <i class="bi bi-arrow-left-right me-1 text-primary"></i>Geser tabel ke samping <i class="bi bi-chevron-right ms-0.5"></i>
</div>

<!-- Table -->
<div class="card">
    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0; font-size:14px;"><i class="bi bi-table me-2 text-primary"></i>Riwayat Tiket Selesai — Durasi Perbaikan</h3>
        <span style="font-size:11px; color:var(--muted);">Total @total tiket</span>
    </div>


    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Serial Number</th>
                    <th>User</th>
                    <th>Kategori</th>
                    <th>Priority</th>
                    <th>Tgl Masuk</th>
                    <th>Tgl Selesai</th>
                    <th class="text-center">Durasi (Jam)</th>
                    <th class="text-center">Status SLA</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int no = 1;
                    var ticketList = ViewBag.CompletedTickets as System.Collections.IEnumerable;
                    if (ticketList != null)
                    {
                        foreach (dynamic t in ticketList)
                        {
                            bool inSLA = t.DalamSLA;
                            <tr>
                                <td style="color:var(--muted); font-size:11px;">@no</td>
                                <td><strong class="font-monospace" style="font-size:12px;">@t.SerialNumber</strong></td>
                                <td style="font-size:12px;">@t.NamaUser</td>
                                <td><span style="font-size:11px; color:var(--muted);">@t.TroubleKategori</span></td>
                                <td>
                                    @if (t.Priority == "Urgent")
                                    {
                                        <span class="badge" style="background:#ef4444; color:#fff; font-size:10px;">URGENT</span>
                                    }
                                    else
                                    {
                                        <span class="badge" style="background:#e2e8f0; color:#475569; font-size:10px;">Normal</span>
                                    }
                                </td>
                                <td style="font-size:11px; color:var(--muted);">@t.TanggalMasuk.ToString("dd MMM yyyy")</td>
                                <td style="font-size:11px; color:var(--muted);">@t.TanggalSelesai.ToString("dd MMM yyyy")</td>
                                <td class="text-center">
                                    <span style="font-weight:700; font-family:'Courier New',monospace; font-size:13px; color:@(inSLA ? "var(--success)" : "#ef4444");">
                                        @t.DurasiJam
                                    </span>
                                </td>
                                <td class="text-center">
                                    @if (inSLA)
                                    {
                                        <span style="background:#dcfce7; color:#166534; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600;">
                                            <i class="bi bi-check-circle-fill me-1"></i>Dalam SLA
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="background:#fee2e2; color:#991b1b; padding:2px 8px; border-radius:20px; font-size:11px; font-weight:600;">
                                            <i class="bi bi-x-circle-fill me-1"></i>Lewat SLA
                                        </span>
                                    }
                                </td>
                            </tr>
                            no++;
                        }
                    }
                }
                @if (total == 0)
                {
                    <tr>
                        <td colspan="9" style="text-align:center; padding:32px; color:var(--muted);">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>Belum ada tiket yang selesai.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@using ITAssetTrack.Models
@{
    ViewData["Title"] = "Detail Pencapaian Target PM";
    ViewData["PageLabel"] = "Detail Pencapaian PM";

    string monthName = ViewBag.MonthName ?? "";
    int targetQty = ViewBag.TargetQty ?? 0;
    int realized = ViewBag.Realized ?? 0;
    double ach = ViewBag.Achievement ?? 0;
    int inProgress = ViewBag.InProgress ?? 0;
    int pending = ViewBag.Pending ?? 0;
    var scheduledList = ViewBag.ScheduledList as List<ScheduledMaint> ?? new();
}

<!-- Page Header Bar -->
<div class="detail-header-bar">
    <div style="display:flex; align-items:center; gap:12px;">
        <a href="@Url.Action("MaintenanceDashboard","Home")" class="btn btn-sm btn-outline" style="font-size:12px; white-space:nowrap;">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
        <div>
            <div style="font-size:15px; font-weight:700; color:var(--text-primary);">
                <i class="bi bi-trophy-fill me-2" style="color:#818cf8;"></i>Detail Pencapaian Target PM — @monthName
            </div>
            <div style="font-size:12px; color:var(--muted); margin-top:2px;">Realisasi vs Target Scheduled Maintenance Bulanan</div>
        </div>
    </div>
    <!-- Stat pills (horizontal swipe on mobile) -->
    <div class="detail-stat-pills">
        <span style="background:#1e1b4b; color:#c7d2fe; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:700;">
            <i class="bi bi-trophy me-1"></i>@ach.ToString("G", System.Globalization.CultureInfo.InvariantCulture)%
        </span>
        <span style="background:#dcfce7; color:#166534; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            <i class="bi bi-check-circle-fill me-1"></i>@realized / @targetQty Selesai
        </span>
        <span style="background:#dbeafe; color:#1e40af; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            @inProgress InProgress
        </span>
        <span style="background:#fef9c3; color:#854d0e; padding:4px 12px; border-radius:20px; font-size:12px; font-weight:600;">
            @pending Pending
        </span>
    </div>
</div>

<!-- Mobile Table Scroll Hint -->
<div class="d-block d-sm-none mb-1 px-1 text-end" style="font-size:10px; color:#64748b;">
    <i class="bi bi-arrow-left-right me-1 text-primary"></i>Geser tabel ke samping <i class="bi bi-chevron-right ms-0.5"></i>
</div>

<!-- Table -->
<div class="card">

    <div class="card-header" style="display:flex; justify-content:space-between; align-items:center;">
        <h3 style="margin:0; font-size:14px;"><i class="bi bi-calendar3 me-2 text-primary"></i>Daftar Scheduled PM — @monthName</h3>
        <span style="font-size:11px; color:var(--muted);">Total @scheduledList.Count unit</span>
    </div>

    <div class="table-wrapper">
        <table class="data-table">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Serial Number</th>
                    <th>User / Teknisi</th>
                    <th>Site</th>
                    <th class="text-center">Tgl Plan</th>
                    <th class="text-center">Tgl Selesai</th>
                    <th class="text-center">Status</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int no = 1;
                    foreach (var s in scheduledList)
                    {
                        string statusStyle = s.Status switch
                        {
                            "Completed" or "PmDone" or "Returned" => "background:#dcfce7; color:#166534;",
                            "InProgress" => "background:#dbeafe; color:#1e40af;",
                            _ => "background:#f1f5f9; color:#64748b;"
                        };
                        <tr>
                            <td style="color:var(--muted); font-size:11px;">@no</td>
                            <td><strong class="font-monospace" style="font-size:12px;">@s.SerialNumber</strong></td>
                            <td style="font-size:12px;">@(string.IsNullOrEmpty(s.NamaUser) ? "—" : s.NamaUser)</td>
                            <td style="font-size:11px; color:var(--muted);">@(s.Site ?? "—")</td>
                            <td class="text-center" style="font-size:11px; color:var(--muted);">
                                @(s.PlanDate.HasValue ? s.PlanDate.Value.ToString("dd MMM yyyy") : "—")
                            </td>
                            <td class="text-center" style="font-size:11px; color:var(--muted);">
                                @(s.UpdatedAt.HasValue ? s.UpdatedAt.Value.ToString("dd MMM yyyy") : "—")
                            </td>
                            <td class="text-center">
                                <span style="@statusStyle padding:2px 10px; border-radius:20px; font-size:11px; font-weight:600;">
                                    @s.Status
                                </span>
                            </td>
                        </tr>
                        no++;
                    }
                }
                @if (!scheduledList.Any())
                {
                    <tr>
                        <td colspan="7" style="text-align:center; padding:32px; color:var(--muted);">
                            <i class="bi bi-inbox fs-3 d-block mb-2"></i>Tidak ada PM yang dijadwalkan bulan ini.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

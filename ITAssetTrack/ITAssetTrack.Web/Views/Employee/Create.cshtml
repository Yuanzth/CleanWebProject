@model ITAssetTrack.Models.Employee

@{
    ViewData["Title"] = "Tambah Employee Baru";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="mb-1 fw-bold text-dark"><i class="bi bi-person-plus-fill text-primary me-2"></i>Tambah Employee Baru</h4>
        <p class="text-muted small mb-0">Isi formulir untuk menambahan karyawan baru ke sistem</p>
    </div>
    <a href="@Url.Action("Index", "Employee")" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
        <i class="bi bi-arrow-left me-1"></i> Kembali
    </a>
</div>

<div class="card border-0 shadow-sm rounded-4">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-semibold">NRP</label>
                    <input asp-for="NRP" class="form-control rounded-3" placeholder="Contoh: NRP00123" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Nama Lengkap <span class="text-danger">*</span></label>
                    <input asp-for="FullName" class="form-control rounded-3" required placeholder="Masukkan nama lengkap" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">Email</label>
                    <input asp-for="Email" type="email" class="form-control rounded-3" placeholder="nama@infrahub.com" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-semibold">No HP / Telepon</label>
                    <input asp-for="Phone" class="form-control rounded-3" placeholder="0812xxxxxxxx" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Site / Lokasi</label>
                    <select asp-for="SiteId" class="form-select rounded-3">
                        <option value="">-- Pilih Site --</option>
                        @foreach (var site in (IEnumerable<ITAssetTrack.Models.Site>)ViewBag.Sites)
                        {
                            <option value="@site.Id">@site.Code - @site.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Department</label>
                    <select asp-for="DepartmentId" class="form-select rounded-3">
                        <option value="">-- Pilih Department --</option>
                        @foreach (var dept in (IEnumerable<ITAssetTrack.Models.Department>)ViewBag.Departments)
                        {
                            <option value="@dept.Id">@dept.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Divisi</label>
                    <select asp-for="DivisionId" class="form-select rounded-3">
                        <option value="">-- Pilih Divisi --</option>
                        @foreach (var div in (IEnumerable<ITAssetTrack.Models.Division>)ViewBag.Divisions)
                        {
                            <option value="@div.Id">@div.Code - @div.Name</option>
                        }
                    </select>
                </div>
                <div class="col-12 mt-4">
                    <button type="submit" class="btn btn-primary rounded-pill px-4 shadow-sm">
                        <i class="bi bi-save me-1"></i> Simpan Employee
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

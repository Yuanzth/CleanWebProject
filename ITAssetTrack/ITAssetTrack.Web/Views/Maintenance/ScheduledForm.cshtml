                                    <label for="chkUefiPass">UEFI Password telah distandarisasi</label>
                                    <span class="pm-status-badge badge-pending" id="badgeUefiPass">BELUM</span>
                                </div>
                                <div class="pm-check-item" id="itemBootStorage" onclick="toggleChk('chkBootStorage', 'itemBootStorage', 'badgeBootStorage')">
                                    <input class="form-check-input pm-check-switch" type="checkbox" asp-for="BootOrderStorage" id="chkBootStorage" onclick="event.stopPropagation(); updateChkState('chkBootStorage', 'itemBootStorage', 'badgeBootStorage');" />

                                {
                                    <div class="text-success fw-bold">
                                        <i class="bi bi-check-circle-fill me-1"></i>PM Sudah Dimulai: @Model.PmStartedAt.Value.ToString("HH:mm")
                                    </div>
                                }
                                else
                                {
                                    <button type="button" id="recordStartBtn" class="btn btn-danger rounded-pill px-5 shadow-sm fw-bold">
                                        <i class="bi bi-play-fill me-1"></i> Mulai PM
                                    </button>
                                }

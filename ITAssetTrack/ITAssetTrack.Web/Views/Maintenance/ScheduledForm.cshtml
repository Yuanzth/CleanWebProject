                                    <input class="form-check-input pm-check-switch" type="checkbox" asp-for="SpaceSSD" id="chkSpaceSsd" onclick="event.stopPropagation(); updateChkState('chkSpaceSsd', 'itemSpaceSsd', 'badgeSpaceSsd');" />

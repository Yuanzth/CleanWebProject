                                    <span class="pm-status-badge badge-pending" id="badgeBootStorage">BELUM</span>
                                </div>
                                <div class="pm-check-item" id="itemBootDisable" onclick="toggleChk('chkBootDisable', 'itemBootDisable', 'badgeBootDisable')">
                                    <input class="form-check-input pm-check-switch" type="checkbox" asp-for="BootOrderDisable" id="chkBootDisable" onclick="event.stopPropagation(); updateChkState('chkBootDisable', 'itemBootDisable', 'badgeBootDisable');" />
                                    <label for="chkBootDisable">Menu boot order di-disable</label>
                                    <span class="pm-status-badge badge-pending" id="badgeBootDisable">BELUM</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- 3. Pemeriksaan Sistem (Sistem Setting) -->
                    <div class="col-md-6">
                        <div class="pm-category-card">
                            <div class="pm-category-header">
                                <i class="bi bi-sliders text-success"></i>
                                <span>3. Pemeriksaan Sistem (Sistem Setting)</span>
                            </div>
                            <div class="d-flex flex-column gap-1">
                                <div class="pm-check-item" id="itemDisableAdmin" onclick="toggleChk('chkDisableAdmin', 'itemDisableAdmin', 'badgeDisableAdmin')">
                                    <input class="form-check-input pm-check-switch" type="checkbox" asp-for="DisableAdmin" id="chkDisableAdmin" onclick="event.stopPropagation(); updateChkState('chkDisableAdmin', 'itemDisableAdmin', 'badgeDisableAdmin');" />
                                    <label for="chkDisableAdmin">Disable administrator</label>
                                    <span class="pm-status-badge badge-pending" id="badgeDisableAdmin">BELUM</span>
                                </div>
                                <div class="pm-check-item" id="itemDiskCleanup" onclick="toggleChk('chkDiskCleanup', 'itemDiskCleanup', 'badgeDiskCleanup')">
                                    <input class="form-check-input pm-check-switch" type="checkbox" asp-for="DiskCleanUp" id="chkDiskCleanup" onclick="event.stopPropagation(); updateChkState('chkDiskCleanup', 'itemDiskCleanup', 'badgeDiskCleanup');" />
                                    <label for="chkDiskCleanup">Melakukan Disk Clean Up Drive C dan D</label>

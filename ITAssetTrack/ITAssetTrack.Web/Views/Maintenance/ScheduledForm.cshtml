                    <!-- 2. Pemeriksaan Sistem (UEFI Setting) -->
                    <div class="col-md-6">
                        <div class="pm-category-card">
                            <div class="pm-category-header">
                                <i class="bi bi-shield-lock-fill text-purple" style="color:#7c3aed;"></i>
                                <span>2. Pemeriksaan Sistem (UEFI Setting)</span>
                            </div>
                            <div class="d-flex flex-column gap-1">

@model ITAssetTrack.Models.ScheduledMaint
@{
    ViewData["Title"] = "Form Scheduled Preventive Maintenance";
    ViewData["PageLabel"] = "Form PM";
    var photos = ViewBag.Photos as List<ITAssetTrack.Models.MaintenancePhoto> ?? new List<ITAssetTrack.Models.MaintenancePhoto>();
    bool isNewTarget = ViewBag.IsNewTarget ?? false;
    bool isApproverOnly = (User.IsInRole("Approver1") || User.IsInRole("Approver2")) && !User.IsInRole("Admin") && !User.IsInRole("Coordinator") && !User.IsInRole("Technician");
}

<style>
    /* Prevent wizard action buttons from being obscured by browser navigation bars on mobile devices */
    @@media (max-width: 767.98px) {
        .pm-page {
            padding-bottom: 6rem !important;
        }
    }
</style>

@if (isNewTarget)
{
    @* =====================================================
       MODE 1: TAMBAH TARGET PM (Form Ringkas)
       ===================================================== *@
    <div class="d-flex justify-content-end mb-3">
        <a href="@Url.Action("ScheduledList", "Maintenance")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Kembali
        </a>
    </div>

    <form asp-action="SaveTargetPm" method="post" id="targetPmForm">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PlanMonth" />

        <div class="management-card p-4 mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                <i class="bi bi-calendar-plus text-primary me-2"></i>Data Rencana PM
            </h5>

            <div class="row g-3">
                <!-- Tanggal Rencana -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Tanggal Rencana PM <span class="text-danger">*</span></label>
                    <input type="date" asp-for="PlanDate" class="form-control" required />
                </div>

                <!-- SN + Autofill -->
                <div class="col-md-8">
                    <label class="form-label fw-semibold text-muted">Serial Number (SN) <span class="text-danger">*</span></label>
                    <div class="input-group">
                        <input asp-for="SerialNumber" id="snInputTarget" class="form-control font-monospace fw-bold" placeholder="Masukkan SN perangkat..." required />
                        <button type="button" id="lookupSnBtnTarget" class="btn btn-outline-primary" title="Autofill dari Master Asset">
                            <i class="bi bi-search me-1"></i> Autofill
                        </button>
                    </div>
                    <small class="text-muted">Klik Autofill untuk mengisi otomatis dari Master Asset</small>
                </div>

                <!-- Nama User -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Nama User</label>
                    <input asp-for="NamaUser" id="namaUserInputTarget" class="form-control" placeholder="Nama Lengkap User" />
                </div>
                <!-- NRP -->
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-muted">NRP</label>
                    <input asp-for="NRP" id="nrpInputTarget" class="form-control" placeholder="p619..." />
                </div>
                <!-- Site -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted">Site</label>
                    <input asp-for="Site" id="siteInputTarget" class="form-control" placeholder="HQ_DEPT" />
                </div>
                <!-- Divisi -->
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-muted">Divisi</label>
                    <input asp-for="Division" id="divisionInputTarget" class="form-control" placeholder="SHE" />
                </div>

                <!-- Computer Name -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Computer Name</label>
                    <input asp-for="ComputerName" id="computerNameInputTarget" class="form-control" placeholder="HQ_DEPTMIINB..." />
                </div>
                <!-- Brand -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Merek Perangkat</label>
                    <input asp-for="Brand" id="brandInputTarget" class="form-control" placeholder="Dell / HP / Lenovo" />
                </div>
                <!-- Model -->
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-muted">Model / Series</label>
                    <input asp-for="Model" id="modelInputTarget" class="form-control" placeholder="Latitude 7320" />
                </div>
            </div>
        </div>

        <div class="d-flex justify-content-end gap-3 mb-5">
            <a href="@Url.Action("ScheduledList", "Maintenance")" class="btn btn-light rounded-pill px-4">Batal</a>
            <button type="submit" class="btn btn-primary rounded-pill px-5 shadow">
                <i class="bi bi-plus-circle me-1"></i> Simpan Target PM
            </button>
        </div>
    </form>
}
else
{
    @* =====================================================
       MODE 2: MULAI PM - Wizard 4 Page
       ===================================================== *@
    <!-- ===== PROGRESS WIZARD INDICATOR (4 Steps) ===== -->
    <div class="management-card px-3 px-sm-4 py-3 mb-4">
        <!-- Integrated Top Bar inside Card: Title + Kembali / Cetak PDF -->
        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <span class="fw-bold text-dark small"><i class="bi bi-journal-check text-primary me-2"></i>Execution Form PM</span>
            <div class="d-flex align-items-center gap-2">
                @if (Model != null && (Model.Status == "Completed" || Model.Status == "PmDone" || Model.Status == "Returned"))
                {
                    <a href="@Url.Action("PrintScheduledPm", "Maintenance", new { id = Model.Id })" target="_blank" class="btn btn-outline-success btn-sm rounded-pill px-3 shadow-sm" style="font-size:12px;">
                        <i class="bi bi-printer me-1"></i> Cetak PDF
                    </a>
                }
                @if (User.IsInRole("Viewer"))
                {
                    <a href="@Url.Action("MyAsset", "Home")" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" style="font-size:12px;">
                        <i class="bi bi-arrow-left me-1"></i> Kembali
                    </a>
                }
                else
                {
                    <a href="@Url.Action("ScheduledList", "Maintenance", new { monthYear = Model.PlanMonth })" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-sm" style="font-size:12px;">
                        <i class="bi bi-arrow-left me-1"></i> Kembali
                    </a>
                }
            </div>
        </div>

        <div class="d-flex align-items-center justify-content-between position-relative">
            <!-- Progress Line -->
            <div class="position-absolute top-50 start-0 end-0 translate-middle-y" style="height: 3px; background: #e2e8f0; margin: 0 40px; z-index:0;"></div>
            <div id="progressLine" class="position-absolute top-50 start-0 translate-middle-y" style="height: 3px; background: linear-gradient(90deg,#3b82f6,#10b981); width: 12.5%; margin-left: 40px; transition: width 0.4s ease; z-index:1;"></div>

            <!-- Step 1 -->
            <div class="d-flex flex-column align-items-center gap-1 position-relative" style="z-index:2;">
                <div id="stepCircle1" class="d-flex align-items-center justify-content-center rounded-circle fw-bold text-white" style="width:40px;height:40px;background:#3b82f6;transition:all .3s;">1</div>
                <small id="stepLabel1" class="fw-bold text-primary" style="font-size:0.72rem;">Identitas & User</small>
            </div>
            <!-- Step 2 -->
            <div class="d-flex flex-column align-items-center gap-1 position-relative" style="z-index:2;">
                <div id="stepCircle2" class="d-flex align-items-center justify-content-center rounded-circle fw-bold" style="width:40px;height:40px;background:#e2e8f0;color:#94a3b8;transition:all .3s;">2</div>
                <small id="stepLabel2" class="text-muted" style="font-size:0.72rem;">Hardware & Software</small>
            </div>
            <!-- Step 3 -->
            <div class="d-flex flex-column align-items-center gap-1 position-relative" style="z-index:2;">
                <div id="stepCircle3" class="d-flex align-items-center justify-content-center rounded-circle fw-bold" style="width:40px;height:40px;background:#e2e8f0;color:#94a3b8;transition:all .3s;">3</div>
                <small id="stepLabel3" class="text-muted" style="font-size:0.72rem;">Checklist & Remark</small>
            </div>
            <!-- Step 4 -->
            <div class="d-flex flex-column align-items-center gap-1 position-relative" style="z-index:2;">
                <div id="stepCircle4" class="d-flex align-items-center justify-content-center rounded-circle fw-bold" style="width:40px;height:40px;background:#e2e8f0;color:#94a3b8;transition:all .3s;">4</div>
                <small id="stepLabel4" class="text-muted" style="font-size:0.72rem;">Pengesahan</small>
            </div>
        </div>
    </div>

    <form asp-action="ScheduledForm" method="post" id="pmForm" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <input type="hidden" asp-for="PlanMonth" />
        <input type="hidden" asp-for="PlanDate" />
        <input type="hidden" asp-for="PmStartedAt" />
        <input type="hidden" asp-for="PmCompletedAt" />
        <input type="hidden" id="execBySigData" name="ExecBySignatureData" value="@Model.ExecBySignature" />
        <input type="hidden" id="userHandoverSigData" name="UserHandoverSignatureData" value="@Model.UserHandoverSignature" />
        <input type="hidden" id="leaderSigData" name="LeaderSignatureData" value="@Model.LeaderSignature" />
        <input type="hidden" id="itosSigData" name="ItosSignatureData" value="@Model.ItosSectionHeadSignature" />

        <fieldset @(User.IsInRole("Viewer") ? "disabled" : "")>

        <!-- ===================================================
             PAGE 1: IDENTITAS PERANGKAT & USER
             =================================================== -->
        <div id="page1" class="pm-page">
            <div class="management-card p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-person-vcard text-primary me-2"></i>Identitas Perangkat &amp; User
                </h5>
                <div class="row g-3">
                    <!-- No. Dokumen -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted">No. Dokumen FORM PM</label>
                        <input asp-for="NoDocument" class="form-control form-control-sm fw-bold bg-light" readonly />
                    </div>
                    <!-- SN -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted">Serial Number (SN)</label>
                        <div class="input-group input-group-sm">
                            <input asp-for="SerialNumber" id="snInput" class="form-control font-monospace fw-bold" placeholder="Masukkan SN..." required />
                            <button type="button" id="lookupSnBtn" class="btn btn-outline-primary" title="Autofill dari Master Asset">
                                <i class="bi bi-search me-1"></i> Autofill
                            </button>
                        </div>
                    </div>
                    <!-- Computer Name -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted">Computer Name</label>
                        <input asp-for="ComputerName" id="computerNameInput" class="form-control form-control-sm" placeholder="HQ_DEPTMIINB..." />
                    </div>

                    <!-- Nama User -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Nama User</label>
                        <input asp-for="NamaUser" id="namaUserInput" class="form-control form-control-sm" placeholder="Nama Lengkap User" />
                    </div>
                    <!-- NRP -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">NRP</label>
                        <input asp-for="NRP" id="nrpInput" class="form-control form-control-sm" placeholder="p619..." />
                    </div>
                    <!-- Site -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Site</label>
                        <input asp-for="Site" id="siteInput" class="form-control form-control-sm" placeholder="Site (HQ_DEPT)" />
                    </div>
                    <!-- Divisi -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Divisi</label>
                        <input asp-for="Division" id="divisionInput" class="form-control form-control-sm" placeholder="Divisi (SHE)" />
                    </div>

                    <!-- Kontak -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">No. Handphone</label>
                        <input asp-for="ContactInfo" class="form-control form-control-sm" placeholder="Contoh: +62 812..." />
                    </div>
                    <!-- Email -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold text-muted">Email User</label>
                        <input asp-for="Email" class="form-control form-control-sm" placeholder="user@infrahub.com" />
                    </div>
                    <!-- Teknisi -->
                    <div class="col-md-5">
                        <label class="form-label fw-semibold text-muted">Pelaksana PM</label>
                        <select asp-for="PerformedBy" id="performedByInput" class="form-select form-select-sm">
                            <option value="">-- Pilih Teknisi --</option>
                            @if (!string.IsNullOrWhiteSpace(Model.PerformedBy) && Model.PerformedBy != "Elyas" && Model.PerformedBy != "Putra" && Model.PerformedBy.ToLower() != "admin")
                            {
                                <option value="@Model.PerformedBy">@Model.PerformedBy</option>
                            }
                            <option value="Elyas">Elyas</option>
                            <option value="Putra">Putra</option>
                        </select>
                    </div>

                    <!-- === KELUHAN USER (Page 1 - Atas) === -->
                    <div class="col-12 mt-2">
                        <div class="d-flex align-items-center justify-content-between mb-1">
                            <label class="form-label fw-bold text-dark mb-0">
                                <i class="bi bi-person-exclamation text-danger me-1"></i>Keluhan User <span class="text-danger">*</span>
                            </label>
                        </div>
                        <textarea asp-for="Keluhan" id="keluhanInput" class="form-control" rows="3" placeholder="Tuliskan keluhan atau kendala yang dilaporkan user jika ada..."></textarea>
                    </div>

                    <!-- Foto Pre-PM (Page 1 - Bawah) -->
                    <div class="col-12 mt-3">
                        <div class="p-3 border rounded" style="background: #f0fdf4; border-color: #86efac !important;">
                            <label class="form-label fw-bold text-dark mb-2">
                                <i class="bi bi-camera-fill text-success me-1"></i>Dokumentasi Pre-PM (Pengambilan Device) <span class="text-danger">*</span>
                            </label>
                            <p class="small text-muted mb-3">Foto kondisi device beserta aksesoris sebelum PM dimulai. <strong>Wajib sebelum melanjutkan ke Tahap 2.</strong></p>
                            @if (!User.IsInRole("Viewer"))
                            {
                                <!-- Camera preview for pre-PM photo -->
                                <div id="prePmCameraArea" class="d-none mb-3">
                                    <video id="prePmVideo" autoplay playsinline class="w-100 rounded border" style="max-height:260px;background:#000;"></video>
                                    <div class="d-flex gap-2 mt-2 justify-content-center">
                                        <button type="button" id="btnCapturePrepPm" class="btn btn-success rounded-pill px-4">
                                            <i class="bi bi-camera-fill me-1"></i> Foto Sekarang
                                        </button>
                                        <button type="button" id="btnCancelPrePmCam" class="btn btn-secondary rounded-pill px-3">
                                            <i class="bi bi-x-circle me-1"></i> Batal
                                        </button>
                                    </div>
                                    <canvas id="prePmCanvas" class="d-none"></canvas>
                                </div>
                                <!-- Fallback file input (digunakan jika kamera tidak tersedia) -->
                                <input type="file" accept="image/*" capture="environment" id="startPmCameraInput" class="d-none" />
                                <button type="button" id="btnCameraStartPm" class="btn btn-success rounded-pill px-4 shadow-sm">
                                    <i class="bi bi-camera-fill me-1"></i> Buka Kamera — Ambil Foto Pre-PM
                                </button>
                            }
                            <div id="startPmPhotoPreviewContainer" class="mt-3 text-center @(photos.Any(p => p.PhotoType == "StartPM") ? "" : "d-none")">
                                <small class="text-muted d-block mb-2">Foto Pre-PM:</small>
                                <div class="d-flex gap-2 justify-content-center flex-wrap" id="evidencePhotosList">
                                    @foreach (var ph in photos.Where(p => p.PhotoType == "StartPM"))
                                    {
                                        <div class="position-relative" id="photoItem-@ph.Id">
                                            <img src="@ph.FilePath" alt="@ph.PhotoType" class="img-thumbnail shadow-sm start-pm-photo" style="height: 100px; width: 120px; object-fit: cover; border-radius: 8px; cursor: pointer;" onclick="window.open('@ph.FilePath','_blank')" />
                                            <span class="badge bg-success position-absolute bottom-0 start-50 translate-middle-x mb-1" style="font-size:0.6rem;">Pre-PM</span>
                                            <button type="button" onclick="deletePhoto('@ph.Id', 'photoItem-@ph.Id', 'startPmPhotoPreviewContainer', '#evidencePhotosList')" class="btn btn-danger btn-sm position-absolute top-0 end-0 p-0 d-flex align-items-center justify-content-center" style="width:22px;height:22px;border-radius:50%;font-size:0.65rem;margin:-6px;" title="Hapus Foto">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Next Button Page 1 -->
            <div class="d-flex justify-content-end gap-3 mt-4 mb-4">
                <a href="@Url.Action("ScheduledList", "Maintenance", new { monthYear = Model.PlanMonth })" class="btn btn-light rounded-pill px-4">Batal</a>
                <button type="button" class="btn btn-primary rounded-pill px-5 shadow-sm" onclick="handlePage1Next()">
                    Selanjutnya <i class="bi bi-arrow-right ms-1"></i>
                </button>
            </div>
        </div>

        <!-- ===================================================
             PAGE 2: HARDWARE & SOFTWARE DETAIL
             =================================================== -->
        <div id="page2" class="pm-page d-none">
            <div class="management-card p-4 mb-4">
                <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                    <i class="bi bi-laptop text-primary me-2"></i>Hardware &amp; Software Detail
                </h5>
                <div class="row g-3">
                    <!-- Tipe Perangkat -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Tipe Perangkat</label>
                        <select asp-for="DeviceType" id="deviceTypeSelect" class="form-select form-select-sm">
                            <option value="Notebook">Notebook / Laptop</option>
                            <option value="Desktop">Desktop / Mini PC</option>
                            <option value="Workstation">Workstation</option>
                        </select>
                    </div>
                    <!-- Kondisi Perangkat -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Kondisi Perangkat</label>
                        <select asp-for="DeviceKondisi" class="form-select form-select-sm">
                            <option value="Baik">Baik</option>
                            <option value="Rusak">Rusak</option>
                        </select>
                    </div>
                    <!-- Merk -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Merk</label>
                        <input asp-for="Brand" id="brandInput" class="form-control form-control-sm" placeholder="Dell / HP / Lenovo" />
                    </div>
                    <!-- Model -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Model / Series</label>
                        <input asp-for="Model" id="modelInput" class="form-control form-control-sm" placeholder="Latitude 7320" />
                    </div>

                    <!-- Processor -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Processor</label>
                        <input asp-for="Processor" id="processorInput" class="form-control form-control-sm" placeholder="Intel Core i7..." />
                    </div>
                    <!-- RAM -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">RAM</label>
                        <input asp-for="Ram" id="ramInput" class="form-control form-control-sm" placeholder="16 GB" />
                    </div>
                    <!-- Storage -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Storage (SSD/HDD)</label>
                        <input asp-for="Storage" id="storageInput" class="form-control form-control-sm" placeholder="512 GB SSD" />
                    </div>
                    <!-- Windows -->
                    <div class="col-md-3">
                        <label class="form-label fw-semibold text-muted">Windows Version</label>
                        <input asp-for="WindowsVersion" id="winVerInput" class="form-control form-control-sm" placeholder="Windows 11 Pro" />
                    </div>

                    <!-- ===== AKSESORIS TAMBAHAN ===== -->
                    <div class="col-12 mt-3">
                        <style>
                            .accessory-card {
                                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                                background-color: #ffffff;
                                border: 1px solid #e2e8f0 !important;
                                box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
                                padding: 6px 10px;
                            }
                            .accessory-card:hover {
                                border-color: #cbd5e1 !important;
                                transform: translateY(-1px);
                                box-shadow: 0 4px 10px -2px rgba(0, 0, 0, 0.06), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
                            }
                            .accessory-card .icon-circle {
                                background-color: #f1f5f9;
                                color: #64748b;
                                width: 32px;
                                height: 32px;
                                border-radius: 50%;
                                display: flex;
                                align-items: center;
                                justify-content: center;
                                transition: all 0.25s ease;
                            }
                            .accessory-card .form-check-input {
                                cursor: pointer;
                                width: 2em;
                                height: 1em;
                            }

                            /* Accent-specific checked states */
                            /* Blue Accent (Keyboard) */
                            .accessory-card[data-accent="blue"]:has(.form-check-input:checked) {
                                border-color: #3b82f6 !important;
                                background-color: #f0f7ff !important;
                                box-shadow: 0 4px 10px -2px rgba(59, 130, 246, 0.1);
                            }
                            .accessory-card[data-accent="blue"]:has(.form-check-input:checked) .icon-circle {
                                background-color: #dbeafe !important;
                                color: #1d4ed8 !important;
                            }
                            .accessory-card[data-accent="blue"] .form-check-input:checked {
                                background-color: #3b82f6;
                                border-color: #3b82f6;
                            }

                            /* Indigo Accent (Mouse) */
                            .accessory-card[data-accent="indigo"]:has(.form-check-input:checked) {
                                border-color: #6366f1 !important;
                                background-color: #f5f3ff !important;
                                box-shadow: 0 4px 10px -2px rgba(99, 102, 241, 0.1);
                            }
                            .accessory-card[data-accent="indigo"]:has(.form-check-input:checked) .icon-circle {
                                background-color: #e0e7ff !important;
                                color: #4338ca !important;
                            }
                            .accessory-card[data-accent="indigo"] .form-check-input:checked {
                                background-color: #6366f1;
                                border-color: #6366f1;
                            }

                            /* Emerald Accent (Monitor) */
                            .accessory-card[data-accent="emerald"]:has(.form-check-input:checked) {
                                border-color: #10b981 !important;
                                background-color: #ecfdf5 !important;
                                box-shadow: 0 4px 10px -2px rgba(16, 185, 129, 0.1);
                            }
                            .accessory-card[data-accent="emerald"]:has(.form-check-input:checked) .icon-circle {
                                background-color: #d1fae5 !important;
                                color: #047857 !important;
                            }
                            .accessory-card[data-accent="emerald"] .form-check-input:checked {
                                background-color: #10b981;
                                border-color: #10b981;
                            }

                            /* Amber Accent (Charger) */
                            .accessory-card[data-accent="amber"]:has(.form-check-input:checked) {
                                border-color: #f59e0b !important;
                                background-color: #fffbeb !important;
                                box-shadow: 0 4px 10px -2px rgba(245, 158, 11, 0.1);
                            }
                            .accessory-card[data-accent="amber"]:has(.form-check-input:checked) .icon-circle {

            <!-- Start Time PM Panel (Bawah Tahap 2) -->
            @if (!isApproverOnly)
            {
                <div class="management-card p-4 mb-4" style="border-left: 4px solid #ef4444;">
                    <h5 class="fw-bold text-dark border-bottom pb-2 mb-3">
                        <i class="bi bi-play-circle-fill text-danger me-2"></i>Mulai Waktu PM
                    </h5>
                    <div class="row align-items-center g-3">
                        <div class="col-md-6">
                            <p class="text-muted small mb-2">Tekan <strong>"Mulai PM"</strong> untuk mencatat waktu awal PM. Pastikan checklist di atas dan foto Pre-PM (Tahap 1) sudah selesai.</p>
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Start Time:</span>
                                <input type="text" id="startTimeInput" name="StartTime" class="form-control form-control-sm fw-bold text-success w-auto" readonly style="min-width:120px;" value="@(Model.PmStartedAt.HasValue ? Model.PmStartedAt.Value.ToString("HH:mm") : (Model.StartTime != TimeSpan.Zero ? Model.StartTime.ToString(@"hh\:mm") : ""))" placeholder="--:--" />
                                <span id="startTimeDisplay" class="text-muted small @(Model.PmStartedAt.HasValue ? "" : "d-none")">
                                    <i class="bi bi-check-circle-fill text-success me-1"></i>Waktu tercatat
                                </span>
                            </div>
                        </div>
                        <div class="col-md-6 text-md-end @(Model.PmStartedAt.HasValue ? "d-none d-md-block" : "")">

@model List<ITAssetTrack.Models.UnscheduledMaint>
@{
    ViewData["Title"] = "List Unscheduled Maintenance";
    ViewData["PageLabel"] = "Unscheduled PM";

    bool isApprover1 = User.IsInRole("Approver1");
    bool isApprover2 = User.IsInRole("Approver2");
    bool isApprover = isApprover1 || isApprover2;
    bool canViewApprovals = isApprover || User.IsInRole("Admin") || User.IsInRole("Coordinator") || User.IsInRole("Technician");

    var approvalList = ViewBag.ApprovalList as List<ITAssetTrack.Models.UnscheduledMaint> ?? new List<ITAssetTrack.Models.UnscheduledMaint>();
    var approvedList = ViewBag.ApprovedList as List<ITAssetTrack.Models.UnscheduledMaint> ?? new List<ITAssetTrack.Models.UnscheduledMaint>();
    var approvalPhotos = ViewBag.ApprovalPhotos as List<ITAssetTrack.Models.MaintenancePhoto> ?? new List<ITAssetTrack.Models.MaintenancePhoto>();

    string activeTab = ViewBag.ActiveListTab as string ?? "list";
}

@if (TempData["Success"] != null)
{
    <span id="tempDataSuccess" style="display:none;">@TempData["Success"]</span>
}


<div class="tab-nav mb-3 p-2">
    <div class="d-flex gap-1 gap-sm-2 w-100">
        @if (!isApprover)
        {
            <a href="@Url.Action("UnscheduledForm", "Maintenance")" class="tab-btn flex-fill text-center justify-content-center">
                <i class="bi bi-file-earmark-text me-1"></i><span class="d-none d-sm-inline">Form Unscheduled</span><span class="d-inline d-sm-none">Form</span>
            </a>
        }
        <a href="@Url.Action("UnscheduledList", "Maintenance", new { listTab = "list" })"
           class="tab-btn flex-fill text-center justify-content-center @(activeTab == "list" ? "active" : "")">
            <i class="bi bi-list-ul me-1"></i><span class="d-none d-sm-inline">List Unscheduled</span><span class="d-inline d-sm-none">List Log</span>
        </a>
        @if (canViewApprovals)
        {
            <a href="@Url.Action("UnscheduledList", "Maintenance", new { listTab = "approval" })"
               class="tab-btn flex-fill text-center justify-content-center @(activeTab == "approval" ? "active" : "")">
                <i class="bi bi-patch-check me-1"></i><span class="d-none d-sm-inline">Approval Unscheduled</span><span class="d-inline d-sm-none">Approval</span>
                @if (approvalList.Any())
                {
                    <span class="badge bg-danger ms-1" style="font-size:10px;">@approvalList.Count</span>
                }
            </a>
        }
    </div>
</div>

@if (activeTab == "list")
{
    <div class="list-toolbar flex-column flex-sm-row gap-2">
        <div class="search-input w-100">
            <i class="bi bi-search"></i>
            <input type="text" id="searchInput" placeholder="Cari nama user, serial number, site..." />
        </div>
        <form method="get" class="filter-form d-flex gap-2 w-100 align-items-center">
            <input type="hidden" name="listTab" value="list" />
            <select name="status" class="form-select form-select-sm flex-fill" onchange="this.form.submit()">
                <option value="">All Status</option>
                @{
                    var fs = ViewBag.FilterStatus as string;
                    var fp = ViewBag.FilterPriority as string;
                }
                @if (fs == "InProgress") { <option value="InProgress" selected="selected">In Progress</option> }
                else { <option value="InProgress">In Progress</option> }
                @if (fs == "WaitingSparepart") { <option value="WaitingSparepart" selected="selected">Waiting Sparepart</option> }
                else { <option value="WaitingSparepart">Waiting Sparepart</option> }
                @if (fs == "Complete") { <option value="Complete" selected="selected">Complete</option> }
                else { <option value="Complete">Complete</option> }
            </select>
            <select name="priority" class="form-select form-select-sm flex-fill" onchange="this.form.submit()">
                <option value="">All Priority</option>
                @if (fp == "Normal") { <option value="Normal" selected="selected">Normal</option> }
                else { <option value="Normal">Normal</option> }
                @if (fp == "Urgent") { <option value="Urgent" selected="selected">Urgent</option> }
                else { <option value="Urgent">Urgent</option> }
            </select>
            @if (!string.IsNullOrEmpty(fs) || !string.IsNullOrEmpty(fp))
            {
                <a href="@Url.Action("UnscheduledList","Maintenance")" class="btn btn-outline-secondary btn-sm" style="white-space:nowrap; border-radius:6px; font-size:12px;">
                    <i class="bi bi-x-circle"></i> Reset
                </a>
            }
        </form>
    </div>

    <div class="card border-0 shadow-sm" style="border-radius:12px;">
        <div class="table-wrapper">
            @if (Model.Any())
            {
                <table class="data-table management-table align-middle w-100" id="pmTable">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Tanggal</th>
                            <th>Nama User</th>
                            <th>Computer Name</th>
                            <th>Serial Number</th>
                            <th>Trouble</th>
                            <th>Priority</th>
                            <th>Status</th>
                            <th style="text-align:right; width:80px;">Aksi</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (int i = 0; i < Model.Count; i++)
                        {
                            var pm = Model[i];
                            string statusBadge = pm.Status switch {
                                "InProgress" => "bg-primary",
                                "WaitingSparepart" => "bg-warning text-dark",
                                "Complete" => "bg-success",
                                _ => "bg-secondary"
                            };
                            string priorityBadge = pm.Priority == "Urgent" ? "bg-danger" : "bg-info text-dark";
                            <tr>
                                <td data-label="#">@(i + 1)</td>
                                <td data-label="Tanggal">@pm.Tanggal.ToString("dd MMM yyyy")</td>
                                <td data-label="Nama User">
                                    <strong>@pm.NamaUser</strong><br />
                                    <span style="font-size:11px;color:#666;">@pm.Site</span>
                                </td>
                                <td data-label="Computer">@pm.ComputerName</td>
                                <td data-label="SN">@pm.SerialNumber</td>
                                <td data-label="Trouble">
                                    <span style="font-weight:600;">@pm.TroubleKategori</span><br/>
                                    <span style="font-size:11px;">@pm.Keluhan</span>
                                </td>
                                <td data-label="Priority"><span class="badge @priorityBadge">@pm.Priority</span></td>
                                <td data-label="Status"><span class="badge @statusBadge">@pm.Status</span></td>
                                <td data-label="Aksi" class="text-end">
                                    <div style="display:flex;gap:4px;justify-content:flex-end;align-items:center;">
                                        <a href="@Url.Action("UnscheduledDetail", "Maintenance", new { id = pm.Id })" class="btn-action-icon" style="color:var(--infrahub-blue);background:var(--gray-100);display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:4px;text-decoration:none;" title="Detail/Update">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        <form asp-action="DeleteUnscheduled" asp-route-id="@pm.Id" method="post" style="margin:0;display:inline;">
                                            <button type="button" class="btn-action-icon btn-action-delete btn-delete-unscheduled" title="Hapus">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            {
                <div class="empty-state">
                    <i class="bi bi-inbox"></i>
                    <p>Belum ada data Unscheduled Maintenance.</p>
                </div>
            }
        </div>
    </div>
}
else if (activeTab == "approval" && canViewApprovals)
{
    <div class="mb-3">
        <p class="text-muted mb-0" style="font-size:14px;">
            @if (isApprover1)
            {
                <span><i class="bi bi-info-circle me-1"></i>Anda login sebagai <strong>Section Head</strong>. Tiket di bawah memerlukan tanda tangan Anda.</span>
            }
            else if (isApprover2)
            {
                <span><i class="bi bi-info-circle me-1"></i>Anda login sebagai <strong>Dept Head</strong>. Tiket muncul setelah Section Head menyetujui.</span>
            }
            else
            {
                <span><i class="bi bi-info-circle me-1"></i>Daftar semua tiket yang memerlukan persetujuan tanda tangan.</span>
            }
        </p>
    </div>

    <div class="d-flex gap-0 mb-0" style="border-bottom:2px solid var(--gray-200);">
        <button id="tabPending" onclick="switchSubTab('pending')"
                style="border-radius:8px 8px 0 0;font-weight:600;border:none;padding:10px 24px;background:transparent;border-bottom:3px solid var(--infrahub-blue);color:var(--infrahub-blue);cursor:pointer;">
            <i class="bi bi-pen me-1"></i> Belum di TTD
            @if (approvalList.Any()) { <span class="badge bg-danger ms-1">@approvalList.Count</span> }
        </button>
        <button id="tabApproved" onclick="switchSubTab('approved')"
                style="border-radius:8px 8px 0 0;font-weight:600;border:none;padding:10px 24px;background:transparent;color:var(--gray-500);cursor:pointer;">
            <i class="bi bi-check2-all me-1"></i> Sudah di TTD
            @if (approvedList.Any()) { <span class="badge bg-success ms-1">@approvedList.Count</span> }
        </button>
    </div>

    <div id="pendingSection">
        <div class="card shadow-sm border-0" style="background:#fff;border-radius:0 12px 12px 12px;padding:24px;">
            <div class="table-wrapper">
                @if (approvalList.Any())
                {
                    <table class="data-table management-table align-middle w-100" id="approvalsTable">
                        <thead>
                            <tr>
                                <th style="width:50px;">#</th>
                                <th style="width:110px;">Tanggal</th>
                                <th>User & Site</th>
                                <th>Detail Aset</th>
                                <th>Keluhan & Catatan</th>
                                <th>SLA Waktu</th>
                                <th style="text-align:center;width:150px;">Aksi</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < approvalList.Count; i++)
                            {
                                var ticket = approvalList[i];
                                var ticketPhotos = approvalPhotos.Where(p => p.MaintenanceId == ticket.Id).ToList();
                                <tr>
                                    <td data-label="#">@(i + 1)</td>
                                    <td data-label="Tanggal">
                                        <div class="fw-semibold">@ticket.Tanggal.ToString("dd MMM yyyy")</div>
                                        <div class="text-muted small">ID: @ticket.Id.ToString().Substring(0,8)...</div>
                                    </td>
                                    <td data-label="User & Site">
                                        <strong>@ticket.NamaUser</strong><br />
                                        <span class="text-muted small"><i class="bi bi-geo-alt-fill me-1"></i>@ticket.Site</span>
                                    </td>
                                    <td data-label="Detail Aset">
                                        <span class="fw-semibold">@ticket.ComputerName</span><br />
                                        <span class="font-monospace small text-muted">@ticket.SerialNumber</span>
                                    </td>
                                    <td data-label="Keluhan">
                                        <div class="small"><strong>Masalah:</strong> <span class="text-muted">@ticket.Keluhan</span></div>
                                        <div class="small mt-1"><strong>Tindakan:</strong> <span class="text-success fw-semibold">@ticket.Remark</span></div>
                                        @if (ticketPhotos.Any())
                                        {
                                            <div class="mt-2">
                                                @foreach (var photo in ticketPhotos)
                                                {
                                                    <a href="@photo.FilePath" target="_blank" class="d-inline-block me-1">
                                                        <img src="@photo.FilePath" style="width:32px;height:32px;object-fit:cover;border-radius:4px;border:1px solid var(--gray-300);" />
                                                    </a>
                                                }
                                            </div>
                                        }
                                    </td>
                                    <td data-label="SLA Waktu">
                                        @{
                                            var tStart = ticket.StartTime != TimeSpan.Zero ? ticket.StartTime : ticket.CreatedAt.TimeOfDay;
                                            bool tHasStart = ticket.StartTime != TimeSpan.Zero || ticket.CreatedAt != default;
                                        }
                                        @if (tHasStart)
                                        {
                                            <div class="small">
                                                <i class="bi bi-clock-history me-1"></i>Mulai: @DateTime.Today.Add(tStart).ToString("HH:mm")<br/>
                                                <i class="bi bi-calendar-check me-1"></i>
                                                @if (ticket.EndTime != TimeSpan.Zero)
                                                {
                                                    <span>Selesai: @DateTime.Today.Add(ticket.EndTime).ToString("HH:mm")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted" style="font-size:10px;"><i class="bi bi-pen me-1"></i>Dicatat saat User TTD</span>
                                                }
                                            </div>
                                            <div class="mt-1">
                                                @if (ticket.EndTime != TimeSpan.Zero)
                                                {
                                                    var dur = ticket.EndTime - tStart;
                                                    if (dur.TotalMinutes < 0) dur = TimeSpan.Zero;
                                                    <span class="badge bg-success font-monospace" style="font-size:10px;">@($"{(int)dur.TotalHours}j {dur.Minutes}m")</span>
                                                }
                                                else
                                                {
                                                    var dur = DateTime.Now.TimeOfDay - tStart;
                                                    if (dur.TotalMinutes < 0) dur = TimeSpan.Zero;
                                                    <span class="badge bg-warning text-dark font-monospace" style="font-size:10px;">@($"{(int)dur.TotalHours}j {dur.Minutes}m") ▶</span>
                                                }
                                            </div>
                                        }
                                        else { <span class="text-muted small">-</span> }
                                    </td>
                                     <td data-label="Aksi" class="text-center">
                                         @if (User.IsInRole("Technician") || User.IsInRole("Approver1") || User.IsInRole("Approver2"))
                                         {
                                             <button type="button" class="btn btn-sm btn-danger btn-sign-approval"
                                                     data-id="@ticket.Id" data-user="@ticket.NamaUser" data-sn="@ticket.SerialNumber"
                                                     style="border-radius:6px;font-weight:600;font-size:12px;white-space:nowrap;padding:6px 12px;">
                                                 <i class="bi bi-pencil-square me-1"></i> Tanda Tangan
                                             </button>
                                         }
                                         else
                                         {
                                             <a href="@Url.Action("UnscheduledDetail", "Maintenance", new { id = ticket.Id })" class="btn btn-sm btn-outline-primary"
                                                style="border-radius:6px;font-weight:600;font-size:12px;white-space:nowrap;padding:6px 12px;">
                                                 <i class="bi bi-eye me-1"></i> Lihat Detail
                                             </a>
                                         }
                                     </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-check-circle text-success" style="font-size:48px;"></i>
                        <p class="mt-3 text-secondary fw-semibold">Tidak ada tiket yang memerlukan tanda tangan saat ini.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div id="approvedSection" style="display:none;">
        <div class="card shadow-sm border-0" style="background:#fff;border-radius:0 12px 12px 12px;padding:24px;">
            <div class="table-wrapper">
                @if (approvedList.Any())
                {
                    <table class="data-table management-table align-middle w-100" id="approvedTable">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Tanggal</th>
                                <th>User & Site</th>
                                <th>Detail Aset</th>
                                <th>Keluhan</th>
                                <th style="text-align:center;">Status Persetujuan</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < approvedList.Count; i++)
                            {
                                var ticket = approvedList[i];
                                <tr>
                                    <td data-label="#">@(i+1)</td>
                                    <td data-label="Tanggal"><div class="fw-semibold">@ticket.Tanggal.ToString("dd MMM yyyy")</div></td>
                                    <td data-label="User & Site"><strong>@ticket.NamaUser</strong><br /><span class="text-muted small">@ticket.Site</span></td>
                                    <td data-label="Detail Aset"><span class="fw-semibold">@ticket.ComputerName</span><br /><span class="font-monospace small text-muted">@ticket.SerialNumber</span></td>
                                    <td data-label="Keluhan"><span class="text-muted small">@ticket.Keluhan</span></td>
                                    <td data-label="Status TTD" class="text-end text-sm-center">
                                        <div class="d-flex flex-column align-items-end align-items-sm-center justify-content-end gap-1 small ms-auto text-end" style="width: fit-content;">
                                            @if (!string.IsNullOrEmpty(ticket.TechSignature))
                                            {
                                                <div class="text-success fw-semibold" style="font-size:11px;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Teknisi
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted" style="font-size:11px;">
                                                    <i class="bi bi-clock me-1"></i>Teknisi
                                                </div>
                                            }

                                            @if (ticket.LeaderApproved)
                                            {
                                                <div class="fw-semibold" style="color:#7c3aed;font-size:11px;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>PIC TEAM
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted" style="font-size:11px;">
                                                    <i class="bi bi-hourglass-split me-1"></i>PIC TEAM
                                                </div>
                                            }

                                            @if (ticket.SectionHeadApproved)
                                            {
                                                <div class="text-primary fw-semibold" style="font-size:11px;">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Section Head
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="text-muted" style="font-size:11px;">
                                                    <i class="bi bi-hourglass-split me-1"></i>Section Head
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox text-muted" style="font-size:48px;"></i>
                        <p class="mt-3 text-secondary fw-semibold">Belum ada riwayat persetujuan.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="modal fade" id="approvalModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content shadow-lg" style="border-radius:12px;border:none;">
                <div class="modal-header" style="background:var(--infrahub-blue);color:white;border-top-left-radius:12px;border-top-right-radius:12px;">
                    <h5 class="modal-title fw-bold"><i class="bi bi-pen me-2"></i>Tanda Tangan Persetujuan</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="targetTicketId" />
                    <div class="mb-3 text-center">
                        <p class="mb-1 text-secondary" style="font-size:13px;">Menyetujui perbaikan perangkat untuk:</p>
                        <h6 class="fw-bold text-dark mb-0" id="targetUserLabel">Nama User</h6>
                        <small class="font-monospace text-muted" id="targetSnLabel">SN-XXXX</small>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold mb-2">Goreskan Tanda Tangan Anda: <span class="text-danger">*</span></label>
                        <div style="border:1px solid var(--gray-300);border-radius:8px;background:#fafafa;position:relative;">
                            <canvas id="approverCanvas" style="width:100%;height:200px;display:block;cursor:crosshair;"></canvas>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between align-items-center">
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnClearApprover" style="border-radius:6px;">
                            <i class="bi bi-trash me-1"></i> Bersihkan
                        </button>
                        <span class="text-muted small"><i class="bi bi-info-circle me-1"></i>Tanda tangan digital wajib digoreskan</span>
                    </div>
                </div>
                <div class="modal-footer border-0 p-3 bg-light" style="border-bottom-left-radius:12px;border-bottom-right-radius:12px;">
                    <button type="button" class="btn btn-secondary px-4" data-bs-dismiss="modal" style="border-radius:8px;">Batal</button>
                    <button type="button" class="btn btn-primary px-4" id="btnSubmitApproval" style="border-radius:8px;font-weight:600;">
                        <i class="bi bi-check-lg me-1"></i> Simpan Persetujuan
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        var searchInput = document.getElementById("searchInput");
        if (searchInput) {
            searchInput.addEventListener("keyup", function() {
                let filter = this.value.toLowerCase();
                let rows = document.querySelectorAll("#pmTable tbody tr");
                rows.forEach(row => { row.style.display = row.innerText.toLowerCase().includes(filter) ? "" : "none"; });
            });
        }

        $(document).on('click', '.btn-delete-unscheduled', function(e) {
            e.preventDefault();
            const form = $(this).closest('form');
            Swal.fire({
                title: 'Hapus Log Trouble ini?',
                text: "Data yang dihapus tidak dapat dikembalikan!",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#dc2626',
                cancelButtonColor: '#64748b',
                confirmButtonText: 'Ya, Hapus!',
                cancelButtonText: 'Batal'
            }).then((result) => { if (result.isConfirmed) form.submit(); });
        });

        if (document.getElementById("tempDataSuccess")) {
            Swal.fire({ icon: 'success', title: 'Berhasil', text: document.getElementById("tempDataSuccess").innerText, timer: 3000, showConfirmButton: false });
        }

        function switchSubTab(tab) {
            const pending = document.getElementById('pendingSection');
            const approved = document.getElementById('approvedSection');
            const tabP = document.getElementById('tabPending');
            const tabA = document.getElementById('tabApproved');
            if (!pending) return;
            if (tab === 'pending') {
                pending.style.display = ''; approved.style.display = 'none';
                tabP.style.borderBottom = '3px solid var(--infrahub-blue)'; tabP.style.color = 'var(--infrahub-blue)';
                tabA.style.borderBottom = 'none'; tabA.style.color = 'var(--gray-500)';
            } else {
                pending.style.display = 'none'; approved.style.display = '';
                tabA.style.borderBottom = '3px solid #10b981'; tabA.style.color = '#10b981';
                tabP.style.borderBottom = 'none'; tabP.style.color = 'var(--gray-500)';
            }
        }
    </script>

    @if (canViewApprovals && activeTab == "approval")
    {
        <script src="https://cdn.jsdelivr.net/npm/signature_pad@4.1.7/dist/signature_pad.umd.min.js"></script>
        <script>
            var sigPad = null;
            var approvalModal = null;

            $(document).ready(function() {
                function ajaxPost(url, data) {
                    data = data || {};
                    data.__RequestVerificationToken = $('input[name="__RequestVerificationToken"]').val();
                    return $.post(url, data);
                }

                approvalModal = new bootstrap.Modal(document.getElementById('approvalModal'));

                // Initialize SignaturePad only when modal becomes fully visible (canvas has real dimensions)
                document.getElementById('approvalModal').addEventListener('shown.bs.modal', function () {
                    var canvas = document.getElementById('approverCanvas');
                    if (!canvas) return;
                    var ratio = Math.max(window.devicePixelRatio || 1, 1);
                    canvas.width = canvas.offsetWidth * ratio;
                    canvas.height = canvas.offsetHeight * ratio;
                    canvas.getContext("2d").scale(ratio, ratio);
                    if (!sigPad) {
                        sigPad = new SignaturePad(canvas, { backgroundColor: 'rgba(255,255,255,0)', penColor: 'rgb(0,0,0)' });
                    } else {
                        sigPad.clear();
                    }
                });

                $('#btnClearApprover').on('click', function() { if (sigPad) sigPad.clear(); });

                $(document).on('click', '.btn-sign-approval', function() {
                    $('#targetTicketId').val($(this).data('id'));
                    $('#targetUserLabel').text($(this).data('user'));
                    $('#targetSnLabel').text($(this).data('sn'));
                    approvalModal.show();
                });

                $('#btnSubmitApproval').on('click', function() {
                    var id = $('#targetTicketId').val();
                    if (!sigPad || sigPad.isEmpty()) {
                        Swal.fire({ icon: 'warning', title: 'Tanda Tangan Kosong', text: 'Silakan goreskan tanda tangan Anda terlebih dahulu.', confirmButtonColor: '#3085d6' });
                        return;
                    }
                    Swal.fire({
                        title: 'Simpan Persetujuan?', text: 'Dokumen perbaikan akan ditandatangani.', icon: 'question',
                        showCancelButton: true, confirmButtonColor: '#10b981', cancelButtonColor: '#6c757d',
                        confirmButtonText: 'Ya, Setujui!', cancelButtonText: 'Batal'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            Swal.showLoading();
                            ajaxPost('@Url.Action("ApproveUnscheduledTicket", "Maintenance")', { id: id, signature: sigPad.toDataURL() })
                            .done(function(r) {
                                Swal.close();
                                if (r.success) {
                                    Swal.fire({ icon: 'success', title: 'Berhasil disetujui', text: r.message, timer: 2000, showConfirmButton: false })
                                    .then(() => location.reload());
                                } else {
                                    Swal.fire({ icon: 'error', title: 'Gagal', text: r.message });
                                }
                            })
                            .fail(function(xhr) {
                                Swal.close();
                                var errMsg = (xhr.responseJSON && xhr.responseJSON.message) ? xhr.responseJSON.message : 'Gagal menghubungi server.';
                                Swal.fire({ icon: 'error', title: 'Error', text: errMsg });
                            });
                        }
                    });
                });
            });
        </script>
    }
}
